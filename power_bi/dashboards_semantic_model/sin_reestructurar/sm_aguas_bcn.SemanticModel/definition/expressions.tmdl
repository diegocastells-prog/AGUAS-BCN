expression Bossa_de_Limitadors_LLOBS = ```
		//
		
		// ESTA FACT SE GENERA A PARTIR DEL ARCHIVO DE GOOGLE DRIVE 
		
		//            Bossa de Limitadors_Canvis per DOP 
		
		// PESTAÑA:
		
		//              LLOBS
		
		let
		  Origen = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1G9GggBeQbtbK0kD-I7o1ypbgcIGSwQGkRXSvvtn8MaE/edit?gid=1653593212#gid=1653593212"),
		  LLOBs_Table= Origen{[name = "LLOBS", ItemKind = "Table"]}[Data],
		  Encabezados =
		        Table.PromoteHeaders(LLOBs_Table, [PromoteAllScalars=true]),
		    Columnas =
		        Table.TransformColumnNames(
		            Encabezados,
		            each Text.Replace(Text.Lower(_), " ", "_")
		        ),
		
		    Renombradas =
		        Table.RenameColumns(
		            Columnas,
		            {
		                {"data_instal·lació", "data_instalacion"},
		                {"estratègic", "estrategic"}
		            }
		        ),
		
		    Texto =
		        Table.TransformColumns(
		            Renombradas,
		            {
		                {"sector", Text.Proper, type text},
		                {"prioritat", Text.Proper, type text}
		            }
		        ),
		
		    Seleccionadas =
		        Table.SelectColumns(
		            Texto,
		            {
		                "dop",
		                "sector",
		                "rendiment_sector_(maig_2026)",
		                "polissa_subm",
		                "tipus_subm",
		                "data_instalacion",
		                "edat_comp",
		                "diam_comp",
		                "dn_limitador",
		                "data_alta_subm",
		                "consum_mig_dia",
		                "consum_anual_estimat",
		                "estrategic",
		                "prioritat",
		                "necessitat",
		                "v12_en_m3",
		                "periodos_consecutivos_con_ea"
		            }
		        ),
		
		    SinErrores =
		        Table.ReplaceErrorValues(
		            Seleccionadas,
		            List.Transform(Table.ColumnNames(Seleccionadas), each {_, null})
		        ),
		
		    Tipos =
		        Table.TransformColumnTypes(
		            SinErrores,
		            {
		                {"rendiment_sector_(maig_2026)", type number},
		                {"polissa_subm", type text},
		                {"data_instalacion", type date},
		                {"edat_comp", Int64.Type},
		                {"diam_comp", Int64.Type},
		                {"data_alta_subm", type date},
		                {"consum_mig_dia", type number},
		                {"consum_anual_estimat", type number},
		                {"estrategic", type text},
		                {"necessitat", type text},
		                {"v12_en_m3", type number},
		                {"periodos_consecutivos_con_ea", Int64.Type}
		            }
		        ),
		
		    Limpieza =
		        Table.TransformColumns(
		            Tipos,
		            {
		                {
		                    "sector",
		                    each if _ = "" then null else _,
		                    type nullable text
		                },
		                {
		                    "rendiment_sector_(maig_2026)",
		                    each if _ = "" then null else _,
		                    type nullable number
		                },
		                {
		                    "dn_limitador",
		                    each if _ = "" or _ = "-" then null else _,
		                    type nullable text
		                }
		            }
		        ),
		
		    SinDuplicados =
		        Table.Distinct(Limpieza),
		
		    Resultado =
		        Table.SelectRows(
		            SinDuplicados,
		            each List.NonNullCount(Record.FieldValues(_)) > 0
		        )
		
		in
		    Resultado
		```
