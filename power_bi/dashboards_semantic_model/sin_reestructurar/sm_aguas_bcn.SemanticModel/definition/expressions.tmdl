expression dim_ortomat =
		let
		  Origen = GoogleSheets.Contents(Ortomat_Sectores_sembrados_numero),
		  #"Navegación 1" = Origen{[name = "Sectores_sembrados_numero", ItemKind = "Table"]}[Data],
		
		    #"Encabezados promovidos" = Table.PromoteHeaders(#"Navegación 1", [PromoteAllScalars=true]),
		    #"Columnas quitadas" = Table.RemoveColumns(
		        #"Encabezados promovidos",
		        {"OBJECTID", "DENOMIN_2", "SHAPE_Le_1"}
		    ),
		
		    #"Columnas renombradas" = Table.RenameColumns(
		        #"Columnas quitadas",
		        {
		            {"SAP_ID_2", "sector_id"},
		            {"NUMPOINTS", "unidad_sensors"},
		            { "SHAPE_Ar_1", "area"}
		        }
		    ),
		
		    #"Valores reemplazados" = Table.ReplaceValue(
		        #"Columnas renombradas",
		        "",
		        null,
		        Replacer.ReplaceValue,
		        {"sector_id","unidad_sensors"}
		    ),
		
		    #"Tiene sensor agregado" = Table.AddColumn(
		        #"Valores reemplazados",
		        "tiene_sensor",
		        each if [unidad_sensors] = null or [unidad_sensors] = 0 then 0 else 1,
		        Int64.Type
		    ),
		
		    #"Filas vacías eliminadas" = Table.SelectRows(
		        #"Tiene sensor agregado",
		        each not (
		            [sector_id] = null and
		            ([unidad_sensors] = null or [unidad_sensors] = 0) and
		            [tiene_sensor] = 0
		        )
		    ),
		
		    #"Filas en blanco eliminadas" = Table.SelectRows(
		        #"Filas vacías eliminadas",
		        each not List.IsEmpty(
		            List.RemoveMatchingItems(Record.FieldValues(_), {"", null})
		        )
		    ),
		
		    #"Duplicados quitados" = Table.Distinct(#"Filas en blanco eliminadas"),
		    #"Tipo cambiado" = Table.TransformColumnTypes(#"Duplicados quitados",{{"sector_id", Int64.Type}, {"area", type number}, {"unidad_sensors", Int64.Type}})
		in
		    #"Tipo cambiado"
