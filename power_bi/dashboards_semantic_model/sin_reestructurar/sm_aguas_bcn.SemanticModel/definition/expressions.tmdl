expression fact_rend_anr_arterias_multi_dz_mensual =
		let
		    Origen = GoogleSheets.Contents(#"Indicador Artèries 2026"),
		
		    Source = Origen{[
		        name = "Multi DZ mensual",
		        ItemKind = "Table"
		    ]}[Data],
		
		    // Mantener únicamente las primeras 14 columnas
		    KeepCols = Table.SelectColumns(
		        Source,
		        List.Transform({1..14}, each "Column" & Text.From(_))
		    ),
		
		    // Convertir todo a texto
		    ToText = Table.TransformColumnTypes(
		        KeepCols,
		        List.Transform(
		            Table.ColumnNames(KeepCols),
		            each {_, type text}
		        ),
		        "es"
		    ),
		
		    // Rellenar hacia abajo la arteria
		    FillArteria = Table.FillDown(
		        Table.ReplaceValue(
		            ToText,
		            "",
		            null,
		            Replacer.ReplaceValue,
		            {"Column1"}
		        ),
		        {"Column1"}
		    ),
		
		    // Quitar las 3 primeras filas y promover encabezados
		    Headers = Table.PromoteHeaders(
		        Table.Skip(FillArteria, 3),
		        [PromoteAllScalars = true]
		    ),
		
		    // Renombrar columnas
		    Rename = Table.RenameColumns(
		        Headers,
		        {
		            {"", "tipo"},
		            {"Artèria Transport", "arteria"}
		        }
		    ),
		
		    // Filtrar Total y rendimiento
		    Filtered = Table.SelectRows(
		        Rename,
		        each [tipo] <> "rendiment (%)"
		            and [arteria] <> "Total"
		    ),
		
		    // Pasar las fechas a filas
		    Unpivoted = Table.UnpivotOtherColumns(
		        Filtered,
		        {"arteria", "tipo"},
		        "fecha",
		        "valor"
		    ),
		
		    // Convertir valores a número
		    NumericValue = Table.TransformColumns(
		        Unpivoted,
		        {{
		            "valor",
		            each try Int64.From(Text.Replace(_, ",", ""))
		                otherwise null,
		            Int64.Type
		        }}
		    ),
		
		    // Convertir tipo en columnas
		    Pivoted = Table.Pivot(
		        NumericValue,
		        List.Distinct(NumericValue[tipo]),
		        "tipo",
		        "valor"
		    ),
		
		    // Renombrar medidas
		    Measures = Table.RenameColumns(
		        Pivoted,
		        {
		            {"sortit (m3)", "sortit_m3"},
		            {"entrat (m3)", "entrat_m3"}
		        }
		    ),
		
		    // Añadir gerencia
		    AddGerencia = Table.AddColumn(
		        Measures,
		        "gerencia",
		        each "Multi DZ",
		        type text
		    ),
		
		    // Calcular rendimiento
		    AddRendiment = Table.AddColumn(
		        AddGerencia,
		        "rendiment",
		        each try [sortit_m3] / [entrat_m3]
		            otherwise null,
		        type number
		    ),
		
		    // Calcular ANR
		    AddANR = Table.AddColumn(
		        AddRendiment,
		        "anr_m3",
		        each [entrat_m3] - [sortit_m3],
		        Int64.Type
		    ),
		
		    // Tipo fecha
		    FinalTypes = Table.TransformColumnTypes(
		        AddANR,
		        {{"fecha", type date}}
		    ),
		
		    // Orden y columnas finales
		    Result = Table.Sort(
		        Table.ReorderColumns(
		            FinalTypes,
		            {
		                "fecha",
		                "gerencia",
		                "arteria",
		                "sortit_m3",
		                "entrat_m3",
		                "rendiment",
		                "anr_m3"
		            }
		        ),
		        {
		            {"arteria", Order.Ascending},
		            {"fecha", Order.Ascending}
		        }
		    )
		in
		    Result
	lineageTag: 35fc2956-323c-41e8-9a1f-36757ce82f11
	queryGroup: Auxiliares\facts\rend_arterias

