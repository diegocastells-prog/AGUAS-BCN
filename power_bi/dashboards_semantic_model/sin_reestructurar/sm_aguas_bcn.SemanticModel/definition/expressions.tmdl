		            {"volum_consumit", Int64.Type}
		        }
		    ),
		    // Limpiar datos
		    SinDuplicados = Table.Distinct(CambiarTipos),
		    #"Valor reemplazado2" = Table.ReplaceValue(SinDuplicados,null,-1,Replacer.ReplaceValue,{"sector_id"}),
		    SinFilasVacias = Table.SelectRows(
