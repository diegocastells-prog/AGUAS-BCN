		        {"ordre", each Text.Trim(Text.Clean(Text.From(_))), type text},
		        {"descripcio", Text.Proper, type text},
		        {"ubicacio_fuita", Text.Proper, type text}
		    }),
		    
		    // 5. AGRUPACIÓN 2: Todos los reemplazos previos a la conversión de tipo anidados
