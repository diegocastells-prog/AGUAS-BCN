		                {"à","a"}, {"è","e"}, {"ò","o"}, 
		                {"ï","i"}, {"ü","u"}
		            }
		        in
		            List.Accumulate(reemplazos, textoBase, (estado, actual) => Text.Replace(estado, actual{0}, actual{1}))
		    ),
		    
		    // 3. Ajuste de estructura Rango, eliminar vacías y renombrar
		    #"Datos Base" = Table.RenameColumns(
		        Table.RemoveColumns(Table.Range(EncabezadosLimpios, 0, 339), {""}), 
		        {{"sector", "sector_id"}}
