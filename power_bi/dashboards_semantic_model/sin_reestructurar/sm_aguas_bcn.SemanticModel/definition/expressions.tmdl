expression fact_rend_anr_arterias_12m =
		let
		    Union =
		        Table.Combine({
		            fact_rend_anr_arterias_llobregadsub_12m,
		            fact_rend_anr_arterias_llobregadnord_12m,
		            fact_rend_anr_arterias_bcn_sud_12m,
		            fact_rend_anr_arterias_bcn_nord_12m,
		            fact_rend_anr_arterias_besos_12m,
		            fact_rend_anr_arterias_multi_dz_12m
		        }),
		
		    Transformado =
		        Table.RenameColumns(
		            Table.ReplaceValue(
		                Table.ReplaceValue(
		                    Table.Sort(
		                        Union,
		                        {
		                            {"gerencia", Order.Ascending},
		                            {"arteria", Order.Ascending},
		                            {"date", Order.Ascending}
		                        }
		                    ),
		                    "Bcn", "Barcelona", Replacer.ReplaceText, {"gerencia"}
		                ),
		                "Besos", "Besòs", Replacer.ReplaceText, {"gerencia"}
		            ),
		            {{"date", "fecha"}}
		        ),
		    sinVacios =
		        Table.SelectRows(
		            Transformado,
		            each [sortit_m3] <> null
		        )
		in
		    sinVacios
