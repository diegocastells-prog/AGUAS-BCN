expression dim_sector_union =
		let
		    dim_sector1 = dim_sector_devoteam,
		    dim_sector2 = dim_sector,
		
		    Union = Table.Combine({
		        dim_sector1,
		        dim_sector2
		    }),
		
		    #"Sin duplicados" = Table.Distinct(
		        Union,
		        {"sector_id"}
		    ),
		
		    Result = Table.Sort(
		        #"Sin duplicados",
		        {
		            {"sector_id", Order.Ascending},
		            {"sector", Order.Ascending},
		            {"gerencia", Order.Ascending}
		        }
		    )
		in
		    Result
