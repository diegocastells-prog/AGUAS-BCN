expression fact_reparacions_zones_2025 = ```
		let
		        Origen = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1ipFAfJGrPVqCxClRGAIMg2tngsjCZrIfh9QJPRksQ5M/edit?gid=1299432866#gid=1299432866"),
		        #"RESUM ACTUACIONS_Table" = Origen{[name="REPARACIONS",ItemKind="Table"]}[Data],
		        #"Rango de filas conservado" = Table.Range(#"RESUM ACTUACIONS_Table",3,997),
		        
		        #"Columnas quitadas preliminar" = Table.RemoveColumns(#"Rango de filas conservado", {"Column1"}, MissingField.Ignore),
		        #"Encabezados promovidos" = Table.PromoteHeaders(#"Columnas quitadas preliminar", [PromoteAllScalars=true]),
		        
		        // 1. Limpieza de nombres de columna (sin 'let' anidado, lista definida en el bloque principal)
		        ReemplazosAcentos = {{"á","a"}, {"é","e"}, {"í","i"}, {"ó","o"}, {"ú","u"}, {"à","a"}, {"è","e"}, {"ò","o"}, {"ï","i"}, {"ü","u"}},
		        EncabezadosLimpios = Table.TransformColumnNames(#"Encabezados promovidos", each List.Accumulate(ReemplazosAcentos, Text.Replace(Text.Lower(Text.Trim(Text.Replace(Text.Replace(_, "#(lf)", " "), "#(cr)", " "))), " ", "_"), (estado, actual) => Text.Replace(estado, actual{0}, actual{1}))),
		        
		        // 2. Transformar sector, filtrar, renombrar y quitar vacías
		        SectorTransformado = Table.TransformColumns(EncabezadosLimpios, {{"sector", each Text.Select(Text.From(_), {"0".."9"}), type text}}),
		        #"Filas filtradas" = Table.SelectRows(SectorTransformado, each ([sector] <> "8001" and [sector] <> "8003")),
		        SectorRenombrado = Table.RenameColumns(#"Filas filtradas", {{"sector", "sector_id"}}),
		        #"Valor reemplazado Sector" = Table.ReplaceValue(SectorRenombrado,"335722","3357",Replacer.ReplaceText,{"sector_id"}),
		        #"Columnas quitadas" = Table.RemoveColumns(#"Valor reemplazado Sector",{""}),
		        
		        // 3. Eliminar filas en blanco de forma dinámica (comprimido en una sola expresión)
		        #"Filas en blanco eliminadas" = Table.SelectRows(#"Columnas quitadas", each not List.IsEmpty(List.RemoveMatchingItems(List.Transform(Record.FieldValues(_), (x) => try Text.Trim(Text.From(x)) otherwise x), {"", null}))),
		
		        // 4. Formatos de Texto y Primeros Reemplazos "--"
		        #"Mayúsculas Aplicadas" = Table.TransformColumns(#"Filas en blanco eliminadas", {
		            {"ubicacio_fuita", Text.Proper, type text}, 
		            {"descripcio", Text.Proper, type text}
		        }),
		        #"Reemplazar Guiones Previos" = Table.ReplaceValue(
		            Table.ReplaceValue(
		                #"Mayúsculas Aplicadas",
		                "--", "No Disponible", Replacer.ReplaceText, {"tipus_actuacio"}
		            ),
		            "--", null, Replacer.ReplaceValue, {"cabal_recuperat"}
		        ),
		
		        // 5. Corrección de filas desplazadas (expresión if...then...else directa)
		        #"Desplazar filas movidas" = Table.FromRecords(
		            Table.TransformRows(
		                #"Reemplazar Guiones Previos",
		                each 
		                    if [cabal_recuperat] <> null and (try Number.From([cabal_recuperat]) otherwise null) = null then 
		                        Record.Combine({_, [descripcio = Text.Trim(Text.From([descripcio]) & " " & Text.From([cabal_recuperat])), cabal_recuperat = [data_fi], data_fi = [cerca_activa], cerca_activa = [tipus_recerca], tipus_recerca = [ubicacio_fuita], ubicacio_fuita = [ordre], ordre = null]}) 
		                    else 
		                        _
		            )
		        ),
		
		        // 6. Reemplazos Finales (Nulos por 0 y guiones en descripción)
		        #"Reemplazos Finales" = Table.ReplaceValue(
		            Table.ReplaceValue(
		                #"Desplazar filas movidas",
		                "--", "No Disponible", Replacer.ReplaceText, {"descripcio"}
		            ),
		            null, 0, Replacer.ReplaceValue, {"cabal_recuperat"}
		        ),
		
		        // 7. Corrección de la columna 'ordre'
		        #"Ordre Corregido" = Table.TransformColumns(#"Reemplazos Finales", {
		            {"ordre", each try Number.FromText(Text.From(_)) otherwise 0, type number}
		        }),
		
		        // 8. Único paso centralizado para aplicar todos los tipos de datos
		        #"Tipo Cambiado Final" = Table.TransformColumnTypes(#"Ordre Corregido", {
		            {"zona", type text}, 
		            {"sector_id", Int64.Type}, 
		            {"tipus_actuacio", type text}, 
		            {"descripcio", type text}, 
		            {"cabal_recuperat", type number},
		            {"data_fi", type date}, 
		            {"cerca_activa", type text}, 
		            {"tipus_recerca", type text}, 
		            {"ubicacio_fuita", type text}
		        }),
		    #"Valor reemplazado" = Table.ReplaceValue(#"Tipo Cambiado Final",null,0,Replacer.ReplaceValue,{"ordre", "cabal_recuperat"}),
		    #"Valor reemplazado1" = Table.ReplaceValue(#"Valor reemplazado","--","No Disponible",Replacer.ReplaceText,{"ubicacio_fuita"})
		in
		    #"Valor reemplazado1"
		```
	lineageTag: f5d104a8-0336-4699-bd72-bcf9781d336d
	queryGroup: Auxiliares\fact_actuacions_zones

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

