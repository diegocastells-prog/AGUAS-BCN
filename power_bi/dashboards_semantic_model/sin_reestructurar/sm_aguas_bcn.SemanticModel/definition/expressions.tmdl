		        {"cerca_activa", type text}, {"tipus_recerca", type text}, {"ubicacio_fuita", type text}, 
		        {"ordre", type number}
		    }),
		    
		    // 7. AGRUPACIÓN 3: Rellenar nulos por ceros en ambas columnas numéricas al mismo tiempo
