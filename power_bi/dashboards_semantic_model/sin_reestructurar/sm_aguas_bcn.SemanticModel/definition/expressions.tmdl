expression perimetre_comptadors_2024 = ```
		// ESTA FACT SE GENERA A PARTIR DEL ARCHIVO DE GOOGLE DRIVE 
		
		//             Perimetre comptadors 2024
		
		// PESTAÑA:
		
		//              2024
		 
		
		
		let
		  Origen = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1yfTHptUIejqioEi7KkYkgmIw7bFXbTdTVuILH4AwB5U/edit?gid=1793108784#gid=1793108784"),
