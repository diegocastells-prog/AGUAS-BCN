						        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.None]
						    ),
						
						    #"Filas superiores quitadas" = Table.Skip(Origen,2),
						    #"Encabezados promovidos" = Table.PromoteHeaders(#"Filas superiores quitadas", [PromoteAllScalars=true]),
						
						    #"Filas filtradas" = Table.SelectRows(#"Encabezados promovidos", each ([Nº] <> null and [Nº] <> "")),
						
						    #"Tipos" = Table.TransformColumnTypes(#"Filas filtradas",{
						        {"Nº", Int64.Type},
						        {"Gerència", type text},
						        {"Sectors", type text}
						    }),
						
						    #"Dimensión limpia" = Table.SelectColumns(#"Tipos",{"Nº","Sectors","Gerència"}),
						
						    #"Renombrado" = Table.RenameColumns(#"Dimensión limpia",{
						        {"Nº","sector_id"},
						        {"Sectors","sector"},
						        {"Gerència","gerencia"}
						    }),
						
						/* opcional pero recomendable */
						    #"Sin duplicados" = Table.Distinct(#"Renombrado")
		in
						    #"Sin duplicados"
