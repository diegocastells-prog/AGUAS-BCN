expression fact_reparacions_zones_2026 = ```
		let
		    Origen = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/10RJ9dh0FLUPfG_zGxGNgFNosF-NQ9ztOAY61R5YPB-E/edit?gid=2126002923#gid=2126002923"),
		    #"RESUM ACTUACIONS_Table" = Origen{[name="REPARACIONS",ItemKind="Table"]}[Data],
		    
		    // 1. Preparación inicial
		    #"Filas superiores quitadas" = Table.Skip(#"RESUM ACTUACIONS_Table", 3),
		    #"Columnas quitadas preliminar" = Table.RemoveColumns(#"Filas superiores quitadas", {"Column1"}, MissingField.Ignore),
		    #"Encabezados promovidos" = Table.PromoteHeaders(#"Columnas quitadas preliminar", [PromoteAllScalars=true]),
		    
		    // 2. Limpieza de nombres de columna (minúsculas, sin acentos y con _)
		    EncabezadosLimpios = Table.TransformColumnNames(#"Encabezados promovidos", each 
		        let
		            sinSaltos = Text.Replace(Text.Replace(_, "#(lf)", " "), "#(cr)", " "),
		            textoBase = Text.Replace(Text.Lower(Text.Trim(sinSaltos)), " ", "_"),
		            reemplazos = {
		                {"á","a"}, {"é","e"}, {"í","i"}, {"ó","o"}, {"ú","u"}, 
		                {"à","a"}, {"è","e"}, {"ò","o"}, 
		                {"ï","i"}, {"ü","u"}
		            }
		        in
		            List.Accumulate(reemplazos, textoBase, (estado, actual) => Text.Replace(estado, actual{0}, actual{1}))
		    ),
		    
		    // 3. Ajuste de estructura Rango, eliminar vacías y renombrar
		    #"Datos Base" = Table.RenameColumns(
		        Table.RemoveColumns(Table.Range(EncabezadosLimpios, 0, 339), {""}), 
		        {{"sector", "sector_id"}}
		    ),
		    
		    // 4. AGRUPACIÓN 1: Transformaciones de Texto en un solo recorrido de tabla
		    #"Transformaciones de Texto" = Table.TransformColumns(#"Datos Base", {
		        {"sector_id", each Text.Select(Text.From(_), {"0".."9"}), type text},
		        {"ordre", each Text.Trim(Text.Clean(Text.From(_))), type text},
		        {"descripcio", Text.Proper, type text},
		        {"ubicacio_fuita", Text.Proper, type text}
		    }),
		    
		    // 5. AGRUPACIÓN 2: Todos los reemplazos previos a la conversión de tipo anidados
		    #"Reemplazos Varios" = Table.ReplaceValue(
		        Table.ReplaceValue(
		            Table.ReplaceValue(
		                #"Transformaciones de Texto",
		                ",", null, Replacer.ReplaceValue, {"ordre"}
		            ),
		            "--", null, Replacer.ReplaceValue, {"cabal_recuperat"}
		        ),
		        "--", "No Disponible", Replacer.ReplaceText, {"tipus_actuacio"}
		    ),
		    
		    // 6. Un único paso para definir todos los tipos de datos a la vez
		    #"Tipo Cambiado" = Table.TransformColumnTypes(#"Reemplazos Varios", {
		        {"zona", type text}, {"sector_id", Int64.Type}, {"tipus_actuacio", type text}, 
		        {"descripcio", type text}, {"cabal_recuperat", type number}, {"data_fi", type date}, 
		        {"cerca_activa", type text}, {"tipus_recerca", type text}, {"ubicacio_fuita", type text}, 
		        {"ordre", type number}
		    }),
		    
		    // 7. AGRUPACIÓN 3: Rellenar nulos por ceros en ambas columnas numéricas al mismo tiempo
		    #"Reemplazar Nulos por Cero" = Table.ReplaceValue(#"Tipo Cambiado", null, 0, Replacer.ReplaceValue, {"ordre", "cabal_recuperat"})
		
		in
		    #"Reemplazar Nulos por Cero"
