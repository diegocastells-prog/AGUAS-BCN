		lineageTag: b2b84bd7-c191-4721-a7c7-bcf08da595ac
		summarizeBy: none
		sourceColumn: fecha

		variation Variación
			isDefault
			relationship: ee9d2b6a-716e-4531-8062-3ddaac6ab3d8
			defaultHierarchy: LocalDateTable_6fcd8bdd-a3cd-43a0-82dc-1d5c6f2b4c14.'Jerarquía de fechas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition fact_dades_consum = m
		mode: import
		source =
				let
				    // Cargar origen
				    origen = GoogleSheets.Contents(
				        "https://docs.google.com/spreadsheets/d/18Il4Zl3lWRN82U12wIePS-sEjeF815d91dmeAOId42c/edit?gid=94400887#gid=94400887"
				    ),
				    tabla = origen{[name = "Sheet", ItemKind = "Table"]}[Data],
				
				    // Promover encabezados y convertirlos a minúsculas
				    encabezados = Table.PromoteHeaders(tabla, [PromoteAllScalars = true]),
				    minusculas = Table.TransformColumnNames(encabezados, Text.Lower),
				
				    // Quitar columnas innecesarias
				    quitarCols = Table.RemoveColumns(minusculas, {"mes nom", "any"}),
				
				    // Crear columna fecha optimizada
				    agregarFecha =
				        Table.AddColumn(
				            quitarCols,
				            "fecha",
				            each
				                let
				                    texto = Text.AfterDelimiter([mes], ", "),
				                    limpio = Text.Replace(texto, ",", ""),
				                    partes = Text.Split(limpio, " "),
				                    mesTxt = Text.Lower(partes{0}),
				                    dia = Number.FromText(partes{1}),
				                    año = Number.FromText(partes{2}),
				                    meses = {"ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"},
				                    mesNum = List.PositionOf(meses, mesTxt) + 1
				                in
				                    #date(año, mesNum, dia)
				        ),
				
				    // Eliminar columna original mes
				    resultado = Table.RemoveColumns(agregarFecha, {"mes"})
				in
				    resultado

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

