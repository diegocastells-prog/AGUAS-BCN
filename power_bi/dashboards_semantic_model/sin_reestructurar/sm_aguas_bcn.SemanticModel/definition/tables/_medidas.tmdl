		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure l_km_global_lytd =
			
			VAR _FechaMaxContexto =
			    MAX('dim_calendario'[Date])
			
			VAR _FechaFinLY =
			    EDATE(
			        _FechaMaxContexto,
			        -12
			    )
			
			VAR _FechaInicioLY =
			    DATE(
			        YEAR(_FechaFinLY),
			        1,
			        1
			    )
			
			VAR _UltimaFechaConDato =
			    MAXX(
			        FILTER(
			            ALL('dim_calendario'[Date]),
			            'dim_calendario'[Date] >= _FechaInicioLY
			                && 'dim_calendario'[Date] <= _FechaFinLY
			                && NOT ISBLANK(
			                    CALCULATE(
			                        SUM(fact_inventari_xarxa_distribucion[xarxa])
			                    )
			                )
			        ),
			        'dim_calendario'[Date]
			    )
			
			VAR _Valor =
			    CALCULATE(
			        SUM(fact_inventari_xarxa_distribucion[xarxa]),
			        'dim_calendario'[Date] = _UltimaFechaConDato
			    )
			
			RETURN
			    DIVIDE(
			        _Valor,
			        1000
			    )
		displayFolder: anr_global\l_km
		lineageTag: e53bc39f-27a5-4421-88ad-d6e75778c145

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure l_km_global_ytd =
			
			VAR FechaMaxContexto =
			    MAX ( 'dim_calendario'[Date] )
			
			VAR AnioActual =
			    YEAR ( FechaMaxContexto )
			
			VAR UltimaFechaConDato =
			    MAXX (
			        FILTER (
			            ALL ( 'dim_calendario' ),
			            YEAR ( 'dim_calendario'[Date] ) = AnioActual
			                && 'dim_calendario'[Date] <= FechaMaxContexto
			                && NOT ISBLANK (
			                    CALCULATE ( [l_km_mensual] )
			                )
			                && CALCULATE ( [l_km_mensual] ) <> 0
			        ),
			        'dim_calendario'[Date]
			    )
			
			RETURN
			    CALCULATE (
			        [l_km_mensual],
			        REMOVEFILTERS ( 'dim_calendario' ),
			        'dim_calendario'[Date] = UltimaFechaConDato
			    )
		displayFolder: anr_global\l_km
		lineageTag: 744a1c2b-a9d0-43d1-989a-d32db470698b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure l_km_ultimo_dato =
			
