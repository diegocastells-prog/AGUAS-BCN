	measure diff_rth_distribucion = ```
			
			VAR _FechaInicio =
			    DATE ( YEAR ( TODAY () ), 1, 1 )
			 
			VAR _FechaFin =
			    TODAY ()
			 
			VAR _FechaMinContexto =
			    MIN ( 'dim_calendario'[Date] )
			 
			VAR _FechaMaxContexto =
			    MAX ( 'dim_calendario'[Date] )
			 
			VAR _ValorActual =
			    [rth_distribucion_mensual]
			 
			VAR _ValorAA =
			    CALCULATE (
			        [rth_distribucion_mensual],
			        DATEADD ( 'dim_calendario'[Date], -1, YEAR )
			    )
			 
			RETURN
			IF (
			    _FechaMaxContexto < _FechaInicio
