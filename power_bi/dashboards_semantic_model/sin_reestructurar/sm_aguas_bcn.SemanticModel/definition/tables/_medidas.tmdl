	measure volum_consumit_global_acum_12m = ```
			
			VAR _FechaFin =    TODAY ()
			VAR _FechaInicio =    EDATE ( _FechaFin, -12 )
			VAR _FechaMinContexto =    MIN ( 'dim_calendario'[Date] )
			VAR _FechaMaxContexto =    MAX ( 'dim_calendario'[Date] )
			VAR _Valor =
			    CALCULATE (
			        SUM(fact_aigua_consum_historic[aigua_consumida_total]),
			        DATESINPERIOD (
			            'dim_calendario'[Date],
			            _FechaMaxContexto,
			            -12,
			            MONTH
			        )
			    )
			RETURN
			IF (
			    _FechaMaxContexto < _FechaInicio
			        || _FechaMinContexto > _FechaFin,
			    BLANK (),
			    DIVIDE ( _Valor, 1000000 )
			)  
			 
			```
		formatString: #,0.00
		displayFolder: anr_global\volum\consumit\acum_12m
		lineageTag: 5e8091e2-7345-4596-bd59-172605b3082a

