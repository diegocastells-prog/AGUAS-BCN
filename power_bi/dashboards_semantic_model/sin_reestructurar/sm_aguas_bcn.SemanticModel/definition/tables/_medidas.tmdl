table _medidas
	lineageTag: 1cfb93bc-b117-4679-93ca-631a08faced9

	measure anr_dia_m3_mensual = ```
			
			DIVIDE(
			    SUM( fact_anr_global_mensual[anr_global_hm3] ),
			    [count_dias_mes],
			    0
			) * 1000000
			
			```
		displayFolder: fact_anr_global_mensual
		lineageTag: adaf3334-5699-4baf-b2c6-dfcffbf821a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure count_dias_mes =
			
			VAR FechaActual =
			    MAX ( dim_calendario[Date] )
			RETURN
			    DAY ( EOMONTH ( FechaActual, 0 ) )
		formatString: 0
		displayFolder: dim_calendario
		lineageTag: 8c5e8213-05f3-474c-bea4-04624f51c582

	measure anr_dia_m3_12m = ```
			
			DIVIDE(
			    SUM( fact_anr_global_acum[anr_global_hm3] ),
			    365,
			    0
			) * 1000000
			
