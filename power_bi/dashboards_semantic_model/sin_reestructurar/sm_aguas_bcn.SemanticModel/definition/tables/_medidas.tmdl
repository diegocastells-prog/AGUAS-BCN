	measure categoria_fraus = ```
			
			VAR RTH = [rth_distribucion_mensual]
			
			VAR EsFuita =
			    [categoria_fuites] = "Fuites"
			
			VAR EsSubcomptatge =
			    [categoria_subcomptatge] = "Subcomptatge"
			
			RETURN
			SWITCH(
			    TRUE(),
			    RTH < 0.85 && NOT EsFuita && NOT EsSubcomptatge, "Fraus",
			    "Sense Fraus"
			) 
			```
		displayFolder: compatodrs\categoritzacio
		lineageTag: 05ea26b3-cfae-4913-a4b2-9d1307816a96

	measure categoria_subcomptatge = ```
			
			VAR RTH = [rth_distribucion_mensual]
			
			VAR Num = [compt_per_sobre_q4] + [compt_per_sobre_q1] + [comptadors_correctiu] + [comptadors_consum_zero] + [subms_mas_3_peri­odes_estimats]
			
			VAR Ratio = DIVIDE(Num, [comptadors])
			
			RETURN
			SWITCH(
			    TRUE(),
			    RTH < 0.85 && Ratio > 0.2, "Subcomptatge",
			    "Sense Subcomptatge"
			)
			
			```
		displayFolder: compatodrs\categoritzacio
		lineageTag: ce986990-2984-4ac0-a0a4-9ed8615ef2f8

	measure sensors_permanents_distribucio = ```
			
			VAR LongInspeccionada = SUM(dim_ortomat[longitud])
			
			VAR SensorsFixes = SUM(dim_ortomat[unidad_sensors])
			
			VAR LongTotal = SUM(dim_dades_sectors[long_xarxa])
			 
			VAR RatioSensors = LongInspeccionada * DIVIDE(SensorsFixes, LongTotal)
			
			RETURN RatioSensors
			//Longitud inspeccionada NÂº Sensors fixes vs longitud total (cuina QGIS)
			
