	measure fraus_detectats_12m = ```
			
			VAR _FechaFin =    TODAY ()
			VAR _FechaInicio =    EDATE ( _FechaFin, -12 )
			VAR _FechaMinContexto =    MIN ( 'dim_calendario'[Date] )
			VAR _FechaMaxContexto =    MAX ( 'dim_calendario'[Date] )
			VAR _Valor =
			    CALCULATE (
			        COUNTROWS('fact_fraudes_all'),
			        'fact_fraudes_all'[ind_resultat] = "S",
			        DATESINPERIOD (
			            'dim_calendario'[Date],
			            _FechaMaxContexto,
			            -12,
			            MONTH
			        )
			    )
			RETURN
			IF (
			    _FechaMaxContexto < _FechaInicio
			        || _FechaMinContexto > _FechaFin,
			    BLANK (),
			    DIVIDE ( _Valor, 1000000 )
			)   
			```
		displayFolder: fraudes\fraus_detectats\acum_12
		lineageTag: 26da5387-9b33-458a-b6ba-c3d01d36e4a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

