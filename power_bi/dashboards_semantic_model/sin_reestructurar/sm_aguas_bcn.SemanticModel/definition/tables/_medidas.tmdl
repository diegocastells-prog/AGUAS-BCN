	measure delta_anr_12m = ```
			
			VAR MesActual = SUM(fact_anr_global_mensual[anr_global_hm3])
			VAR MesAnterior = 
			    CALCULATE(
			        SUM(fact_anr_global_mensual[anr_global_hm3]),
			        PREVIOUSMONTH(dim_calendario[Date])
			    )
			RETURN 
			    DIVIDE(MesActual - MesAnterior, MesAnterior, 0)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: fact_anr_global_acum
		lineageTag: 5f1378c2-905a-4109-9cf9-571560b351e0

