	measure anr_l_esc_dia_ytd =
			
			VAR _FechaMaxContexto =
			    MAX('dim_calendario'[Date])
			
			VAR _FechaInicio =
			    DATE(YEAR(_FechaMaxContexto), 1, 1)
			
			VAR _AnrYTD =
			    CALCULATE(
			        [anr_mensual],
			        DATESBETWEEN(
			            'dim_calendario'[Date],
			            _FechaInicio,
			            _FechaMaxContexto
			        )
			    )
			
			VAR _EscomesesYTD =
			    CALCULATE(
			        AVERAGE('fact_inventari_xarxa_distribucion'[escomeses]),
			        DATESBETWEEN(
			            'dim_calendario'[Date],
			            _FechaInicio,
			            _FechaMaxContexto
			        )
			    )
			
			VAR _DiasYTD =
			    DATEDIFF(
			        _FechaInicio,
			        _FechaMaxContexto,
			        DAY
			    ) + 1
			
			RETURN
			    DIVIDE(
			        _AnrYTD * 1000000000,
			        _EscomesesYTD * _DiasYTD,
			        BLANK()
			    )
		displayFolder: anr\ytd
		lineageTag: cfc8d7af-fb62-4d13-ac62-092337240d2a

