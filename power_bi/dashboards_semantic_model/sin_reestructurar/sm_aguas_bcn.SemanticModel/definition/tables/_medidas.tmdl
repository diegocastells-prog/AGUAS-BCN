	measure categoria_fuites = ```
			
			VAR RTH = [rth_distribucion_mensual]
			VAR DeltaQminVsVolum = [delta_qmin_mensual] - [delta_volum_consumit_distribucion_mensual]
			VAR ZeroSensorsFuitesOrtomat = SUM(dim_dades_sectors[num_points]) = 0
			RETURN
			SWITCH(
			    TRUE(),
			    RTH < 0.85 && ( DeltaQminVsVolum > 0.02 || ZeroSensorsFuitesOrtomat ), "Fuites", 
			    "Sense Fuites"
			)
			
			```
		formatString: 0
		displayFolder: compatodrs\categoritzacio
		lineageTag: 283ca3e6-b074-407f-8c67-137ee83bb95f

