	measure mij_tiempo_resol_fraud =
			
			VAR Dias =
			    AVERAGEX(
			        fact_fraudes_all,
			        DATEDIFF(
			            fact_fraudes_all[data_creacio_original],
			            fact_fraudes_all[data_fi_execucio_final],
			            DAY
			        )
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    Dias < 30, FORMAT(Dias, "0") & " días",
			    Dias < 365, FORMAT(DIVIDE(Dias, 30), "0.0") & " meses",
			    FORMAT(DIVIDE(Dias, 365), "0.0") & " años"
			)
		displayFolder: fraudes
		lineageTag: a4e75447-828b-4094-97d1-7511a72133b5

