	measure categoria_fraus = ```
			
			VAR RTH =
			    CALCULATE(
			        AVERAGE(fact_anr_global_mensual[rth_global])
			    )
			
			VAR EsFuita =
			    [vategoria_fuita] = "Fuita Probable"
			        || [vategoria_fuita] = "Possible Fuita"
			
			VAR EsSubcomptatge =
			    [categoria_subcomptatge] = "Subcomptatge"
			
			RETURN
			SWITCH(
			    TRUE(),
			    RTH < 0.9 && NOT EsFuita && NOT EsSubcomptatge, "Fraus",
			    "Sense Fraus"
			) 
			```
		formatString: 0
		displayFolder: compatodrs\no_column
		lineageTag: 05ea26b3-cfae-4913-a4b2-9d1307816a96

	measure categoria_subcomptatge = ```
			
			VAR RTH =
			    CALCULATE(
			        AVERAGE(fact_anr_global_mensual[rth_global])
			    )
			
			VAR ComptadorsProblematics =
			        SUM(fact_comptadors[Q4_UP])
			      + SUM(fact_comptadors[Q1_DOWN])
			      + SUM(fact_comptadors[COMP_AVARIATS])
			      + SUM(fact_comptadors[COMP_ESTIMATS_3P])
			
			VAR ComptadorsTotals =
			    SUM(fact_comptadors[COMP_TOTALS])
			
			VAR RatioProblematics =
			    DIVIDE(ComptadorsProblematics, ComptadorsTotals)
			
			RETURN
			SWITCH(
			    TRUE(),
			    RTH < 0.9 && RatioProblematics > 0.8, "Subcomptatge",
			    "Sense Subcomptatge"
			)
			
			```
		displayFolder: compatodrs\no_column
		lineageTag: ce986990-2984-4ac0-a0a4-9ed8615ef2f8

	measure sensors_permanents_distribucio = ```
			
			VAR LongInspeccionada =
			    SUM(fact_ortomat[LONG_INSPECCIONADA])
			
			VAR SensorsFixes =
			    SUM(fact_ortomat[SENSORS_FIXES])
			
			VAR LongTotal =
			    SUM(dim_qgis[LONG_TOTAL])
			
			VAR RatioSensors =
			    DIVIDE(SensorsFixes, LongTotal)
			
			RETURN
			RatioSensors
			
			```
		displayFolder: compatodrs\no_column
		lineageTag: 5b7e4d33-f361-4a67-b4b4-b5f3ca388666

	measure categoria_sensors_permanents = ```
			
			VAR Ratio =
			    [sensors_permanents_distribucio]
			RETURN
			SWITCH(
			    TRUE(),
			    Ratio > 0.7, "Cobertura Alta",
			    Ratio > 0.4, "Cobertura Mitjana",
			    "Cobertura Baixa"
			)
			 
			```
		displayFolder: compatodrs\no_column
		lineageTag: bb02ab51-1bce-4d5a-838d-4ee549631b4e

