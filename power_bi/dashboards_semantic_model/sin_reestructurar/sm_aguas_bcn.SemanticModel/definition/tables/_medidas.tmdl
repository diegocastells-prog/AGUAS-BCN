	measure anr_l_subm_dia_mensual_smly =
			
			VAR AnrSM =
			    CALCULATE(
			        [anr_mensual],
			        DATEADD(dim_calendario[Date], -12, MONTH)
			    )
			
			VAR SubmSM =
			    CALCULATE(
			        [subministraments_mensual],
			        DATEADD(dim_calendario[Date], -12, MONTH)
			    )
			
			VAR DiasSM =
			    CALCULATE(
			        [count_dias_mes],
			        DATEADD(dim_calendario[Date], -12, MONTH)
			    )
			
			RETURN
			    DIVIDE(
			        AnrSM * 1000000000,
			        SubmSM * DiasSM,
			        BLANK()
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: anr\subm\mensual
		lineageTag: 2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e

	measure anr_m3_km_dia_mensual_smly =
			
			VAR AnrSM =
			    CALCULATE(
			        [anr_mensual],
			        DATEADD(dim_calendario[Date], -12, MONTH)
			    )
			
			VAR KmSM =
			    CALCULATE(
			        [l_km_mensual],
			        DATEADD(dim_calendario[Date], -12, MONTH)
			    )
			
			VAR DiasSM =
			    CALCULATE(
			        [count_dias_mes],
			        DATEADD(dim_calendario[Date], -12, MONTH)
			    )
			
			RETURN
			    DIVIDE(
			        AnrSM * 1000000,
			        KmSM * DiasSM,
			        BLANK()
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: anr\mensual
		lineageTag: 3c4d5e6f-7a8b-9c0d-1e2f-3a4b5c6d7e8f

