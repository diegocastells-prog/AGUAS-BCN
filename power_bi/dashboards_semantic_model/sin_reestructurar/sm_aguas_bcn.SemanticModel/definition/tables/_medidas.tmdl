	measure Tfuita_%_reparacio_10_dies_acum_12m =
			
			VAR _FechaFin =
			    TODAY ()
			
			VAR _FechaInicio =
			    EDATE ( _FechaFin, -12 )
			
			VAR _FechaMinContexto =
			    MIN ( 'dim_calendario'[Date] )
			
			VAR _FechaMaxContexto =
			    MAX ( 'dim_calendario'[Date] )
			
			VAR VentanaTiempo =
			    DATESINPERIOD (
			        'dim_calendario'[Date],
			        _FechaMaxContexto,
			        -12,
			        MONTH
			    )
			
			VAR TotalAvisos12M =
			    CALCULATE (
			        COUNTROWS ( 'fact_tfuita_tinst' ),
			        VentanaTiempo
			    )
			
			VAR Avisos10Dies12M =
			    CALCULATE (
			        COUNTROWS ( 'fact_tfuita_tinst' ),
			        'fact_tfuita_tinst'[durada_dies] < 10,
			        VentanaTiempo
			    )
			
			VAR _Valor =
			    DIVIDE (
			        Avisos10Dies12M,
			        TotalAvisos12M,
			        0
			    )
			
			RETURN
			    IF (
			        _FechaMaxContexto < _FechaInicio
			            || _FechaMinContexto > _FechaFin,
			        BLANK (),
			        _Valor
			    )
		displayFolder: tfuita\tfuita_%_reparacio_10_dies\acum_12
		lineageTag: 5639fda0-7214-4293-bc0e-24fcf95008eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Tfuita_%_reparacio_15_dies_acum_12m =
			
			VAR _FechaFin =
			    TODAY ()
			
			VAR _FechaInicio =
			    EDATE ( _FechaFin, -12 )
			
			VAR _FechaMinContexto =
			    MIN ( 'dim_calendario'[Date] )
			
			VAR _FechaMaxContexto =
			    MAX ( 'dim_calendario'[Date] )
			
			VAR VentanaTiempo =
			    DATESINPERIOD (
			        'dim_calendario'[Date],
			        _FechaMaxContexto,
			        -12,
			        MONTH
			    )
			
			VAR TotalAvisos12M =
			    CALCULATE (
			        COUNTROWS ( 'fact_tfuita_tinst' ),
			        VentanaTiempo
			    )
			
			VAR Avisos15Dies12M =
			    CALCULATE (
			        COUNTROWS ( 'fact_tfuita_tinst' ),
			        'fact_tfuita_tinst'[durada_dies] <= 15,
			        VentanaTiempo
			    )
			
			RETURN
			    IF (
			        _FechaMaxContexto < _FechaInicio
			            || _FechaMinContexto > _FechaFin,
			        BLANK (),
			        DIVIDE (
			            Avisos15Dies12M,
			            TotalAvisos12M,
			            0
			        )
			    )
		displayFolder: tfuita\tfuita_%_reparacio_15_dies\acum_12
		lineageTag: 81bf1b8a-768a-422d-9b68-d1817fa04e98

