table _medidas
	lineageTag: 1cfb93bc-b117-4679-93ca-631a08faced9

	measure anr_dia_m3_mensual = ```
			
			DIVIDE(
			    SUM( fact_anr_global_mensual[anr_global_hm3] ),
			    [count_dias_mes],
			    0
			) * 1000000
			
			```
		displayFolder: fact_anr_global_mensual
		lineageTag: adaf3334-5699-4baf-b2c6-dfcffbf821a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure count_dias_mes =
			
			VAR FechaActual =
			    MAX ( dim_calendario[Date] )
			RETURN
			    DAY ( EOMONTH ( FechaActual, 0 ) )
		formatString: 0
		displayFolder: dim_calendario
		lineageTag: 8c5e8213-05f3-474c-bea4-04624f51c582

	measure anr_dia_m3_12m = ```
			
			DIVIDE(
			    SUM( fact_anr_global_acum[anr_global_hm3] ),
			    365,
			    0
			) * 1000000
			
			```
		displayFolder: fact_anr_global_acum
		lineageTag: 221c7678-14ee-4777-bdc3-7ec35d2d4c51

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure anr_l_esc_dia_mensual = [anr_dia_m3_mensual] /sum(fact_inventari_xarxa_mensual[nombre_escomeses_totals])
		displayFolder: fact_anr_global_mensual
		lineageTag: ebd07ed5-8585-4fd4-9192-b2503c07f0ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure anr_l_subm_dia_mensual = [anr_dia_m3_mensual] /sum(fact_inventari_xarxa_mensual[nombre_subministraments_totals])
		displayFolder: fact_anr_global_mensual
		lineageTag: e0720a62-8277-4ecd-80da-2a9e35bef545

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure anr_m3_km_dia_mensual = [anr_dia_m3_mensual]/ SUM((fact_inventari_xarxa_mensual[l_+_t_km]))
		displayFolder: fact_anr_global_mensual
		lineageTag: 78d04585-54b5-497b-81cf-f7e36005e56a

