	measure delta_volum_consumit_mensual = ```
			
			
			VAR MesActual = SUM(fact_volum_consumit[volum_consumit])
			VAR MesAnterior = 
			    CALCULATE(
			        SUM(fact_volum_consumit[volum_consumit]),
			        PREVIOUSMONTH(dim_calendario[Date])
			    )
			RETURN 
			    DIVIDE(MesActual - MesAnterior, MesAnterior, 0)
			```
