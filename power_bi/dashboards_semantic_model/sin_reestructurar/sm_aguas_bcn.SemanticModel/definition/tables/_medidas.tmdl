	measure vategoria_fuita = ```
			
			//VAR RTH = AVERAGE(fact_dades_consum[RTH])
			VAR RTH = AVERAGE(fact_anr_global_mensual[rth_global])
			VAR DeltaQmin = SUM(fact_dades_consum[QMIN_HORA]) - SUM(fact_dades_consum[CONSUM_MENSUAL_REAL])
			VAR ZeroSensors = SUM(fact_dades_consum[DIES_AMB_CONSUM_0])
			RETURN
			SWITCH(
			    TRUE(),
			    RTH < 0.9 && DeltaQmin > 0.02, "Fuita Probable",
			    ZeroSensors > 0, "Possible Fuita",
			    "Sense Fuita"
			)
			
			```
		formatString: 0
		displayFolder: compatodrs
		lineageTag: 283ca3e6-b074-407f-8c67-137ee83bb95f

	measure pct_lectures_visuals_vs_totals =
			
