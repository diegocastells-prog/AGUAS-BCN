	partition dim_neccesi_bossa = m
		mode: import
		queryGroup: Dimensiones
		source =
				let
				    AgregarColumnas = (t as table) as table =>
				        let
				            t1 = if List.Contains(Table.ColumnNames(t), "períodes_amb_estimades") then t else Table.AddColumn(t, "períodes_amb_estimades", each null, Int64.Type),
				            t2 = if List.Contains(Table.ColumnNames(t1), "periodos_consecutivos_con_ea") then t1 else Table.AddColumn(t1, "periodos_consecutivos_con_ea", each null, Int64.Type)
				        in
				            t2,
				
				    Union = Table.Combine({
				        AgregarColumnas(Bossa_de_Limitadors_BCNS),
				        AgregarColumnas(Bossa_de_Limitadors_BCNN),
				        AgregarColumnas(Bossa_de_Limitadors_BES),
				        AgregarColumnas(Bossa_de_Limitadors_LLOBN),
				        AgregarColumnas(Bossa_de_Limitadors_LLOBS)
				    }),
				
				    SinDuplicados = Table.Distinct(Union),
				    SinFilasVacias = Table.SelectRows(SinDuplicados, each List.NonNullCount(Record.FieldValues(_)) > 0),
				
				    #"Tipo cambiado" = Table.TransformColumnTypes(SinFilasVacias, {{"dop", type text}, {"tipus_subm", type text}, {"dn_limitador", Int64.Type}}),
