				    #"Columnas quitadas" = Table.RemoveColumns(#"Se expandió dim_gerencia",{"gerencia"}),
				
				    #"Sector normalizado" = Table.TransformColumns(
				        Table.ReplaceValue(
				            Table.ReplaceValue(#"Columnas quitadas", null, "No Disponible", Replacer.ReplaceValue, {"sector"}),
				            "0", "No Disponible", Replacer.ReplaceText, {"sector"}
				        ),
				        {{"sector", each Text.Proper(Text.Replace(Text.Trim(Text.Clean(_)), "Pg Sant Gervasi", "Passeig De Sant Gervasi")), type text}}
				    ),
				
				    #"Consultas combinadas1" = Table.FuzzyNestedJoin(#"Sector normalizado", {"sector"}, dim_dades_sectors, {"sector"}, "dim_dades_sectors", JoinKind.LeftOuter, [IgnoreCase=true, IgnoreSpace=true]),
				    #"Se expandió dim_dades_sectors" = Table.ExpandTableColumn(#"Consultas combinadas1", "dim_dades_sectors", {"sector_id"}, {"sector_id"}),
				    #"Sector_id corregido" = Table.TransformColumnTypes(Table.ReplaceValue(#"Se expandió dim_dades_sectors", null, -1, Replacer.ReplaceValue, {"sector_id"}), {{"sector_id", Int64.Type}}),
				    #"Columnas quitadas1" = Table.RemoveColumns(#"Sector_id corregido",{"sector"}),
				    #"Valor reemplazado" = Table.ReplaceValue(#"Columnas quitadas1","Estimades/Consums 0 O Similars","Estimades/Consums 0 O Similar",Replacer.ReplaceText,{"necessitat"}),
				    #"Valor reemplazado1" = Table.ReplaceValue(#"Valor reemplazado","Canvi Per Avaria Gran","Canvis Per Avaria Gran",Replacer.ReplaceText,{"necessitat"}),
				    #"Otras columnas quitadas" = Table.SelectColumns(#"Valor reemplazado1",{"necessitat"}),
				    #"Duplicados quitados" = Table.Distinct(#"Otras columnas quitadas"),
				    #"Índice agregado" = Table.AddIndexColumn(#"Duplicados quitados", "Índice", 1, 1, Int64.Type),
