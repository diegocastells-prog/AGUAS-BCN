	column fecha
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 008be1a8-3d00-4899-bf5e-bf31e3a18f90
		summarizeBy: none
		isNameInferred
		sourceColumn: [fecha]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition dim_calendario = calculated
		mode: import
		source = ```
				
				VAR Base =
				    SELECTCOLUMNS(
				        CALENDAR(DATE(2020,1,1), DATE(2030,12,31)),
				        "fecha", [Date]        // ← renombramos aquí
				    )
				RETURN
				    ADDCOLUMNS(
				        Base,
				        "anio", YEAR([fecha]),
				        "mes_num", MONTH([fecha]),
				        "mes", FORMAT([fecha], "MMMM"),
				        "mes_corto", FORMAT([fecha], "MMM"),
				        "aniomes", FORMAT([fecha], "YYYYMM"),
				        "anio_mes", FORMAT([fecha], "YYYY-MM"),
				        "trimestre", "T" & FORMAT([fecha], "Q"),
				        "anio_trimestre", YEAR([fecha]) & "-T" & FORMAT([fecha], "Q"),
				        "semana_anio", WEEKNUM([fecha], 2),
				        "dia", DAY([fecha]),
				        "dia_semana_num", WEEKDAY([fecha], 2),
				        "dia_semana", FORMAT([fecha], "dddd"),
				        "fin_de_semana", IF(WEEKDAY([fecha], 2) >= 6, "si", "no")
				    )
				
				```

	annotation PBI_Id = 06946a9e57dd4dfe845e9b08d6bd99d1

