	partition dim_calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2020,1,1),
				        EOMONTH(TODAY(), -1)
				    ),
				 
				    "anio", YEAR([Date]),
				    "mes_num", MONTH([Date]),
				    "mes", SWITCH(MONTH([Date]), 1, "gener", 2, "febrer", 3, "març", 4, "abril", 5, "maig", 6, "juny", 7, "juliol", 8, "agost", 9, "setembre", 10, "octubre", 11, "novembre", 12, "desembre"),
				    "mes_corto", SWITCH(MONTH([Date]), 1, "gen.", 2, "febr.", 3, "març", 4, "abr.", 5, "maig", 6, "juny", 7, "jul.", 8, "ag.", 9, "set.", 10, "oct.", 11, "nov.", 12, "des."),
				    "mestexto_año", SWITCH(MONTH([Date]), 1, "gen.", 2, "febr.", 3, "març", 4, "abr.", 5, "maig", 6, "juny", 7, "jul.", 8, "ag.", 9, "set.", 10, "oct.", 11, "nov.", 12, "des.") & " " & FORMAT([Date], "YYYY"),
				    "mestexto_añocorto", SWITCH(MONTH([Date]), 1, "gen.", 2, "febr.", 3, "març", 4, "abr.", 5, "maig", 6, "juny", 7, "jul.", 8, "ag.", 9, "set.", 10, "oct.", 11, "nov.", 12, "des.") & " " & FORMAT([Date], "YY"),
				    "aniomes", FORMAT([Date], "YYYYMM"),
				    "aniomes_corto", FORMAT([Date], "MM YY"), 
				    "aniomes_corto_con_guion", FORMAT([Date], "MM-YY"), 
				    "aniomes_num_corto", FORMAT([Date], "MM") & "/" & FORMAT([Date],"YY"),
				    "anio2_mes", FORMAT([Date], "YY-MM"),
				    "anio_mes", FORMAT([Date], "YYYY-MMM"),
				    "trimestre", "T" & FORMAT([Date], "Q"),
				    "anio_trimestre", YEAR([Date]) & "-T" & FORMAT([Date], "Q"),
				    "semana_anio", WEEKNUM([Date], 2),
				    "dia", DAY([Date]),
				    "dia_semana_num", WEEKDAY([Date], 2),
				    "dia_semana", FORMAT([Date], "dddd"),
				    "fin_de_semana", IF(WEEKDAY([Date], 2) >= 6, "si", "no"),
				    "status_date",
				        VAR FechaHoy = TODAY()
				        VAR MesActual = EOMONTH(FechaHoy, 0)
				        VAR MesCerradoReal = EOMONTH(FechaHoy, -3)
				        RETURN
				            SWITCH(
				                TRUE(),
				                [Date] <= MesCerradoReal, "REAL",
				                [Date] <= MesActual, "ESTIMADO",
				                "FUTURO"
				            ),
				    "flag_anio",
				        SWITCH(
				            TRUE(),
				            YEAR([Date]) = YEAR(TODAY()), "ACTUAL",
				            YEAR([Date]) = YEAR(TODAY()) - 1, "ANTERIOR",
				            "OTRO"
				        )
				)
				 
				```

	annotation PBI_Id = 06946a9e57dd4dfe845e9b08d6bd99d1

