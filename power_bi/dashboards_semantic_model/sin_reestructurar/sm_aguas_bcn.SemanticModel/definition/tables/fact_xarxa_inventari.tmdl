	partition fact_xarxa_inventari = m
		mode: import
		queryGroup: Hechos
		source =
				let
				    Origen =
				        GoogleSheets.Contents(
				            "https://docs.google.com/spreadsheets/d/1OPforixfO3CH3kj5G07XEn-Fh45e6hv5KcCE8lroBT4/edit?gid=1951645607#gid=1951645607"
				        ),
				
				    Xarxa = Origen{
				        [name="Longitud de la xarxa per Diàmet", ItemKind="Table"]
				    }[Data],
				
				    #"Filas filtradas" =
				        Table.SelectRows(
				            Xarxa,
				            each [Column5] <> null
				                and [Column5] <> ""
				                and [Column5] <> "Total"
				        ),
				
				    #"Encabezados promovidos" =
				        Table.PromoteHeaders(
				            #"Filas filtradas",
				            [PromoteAllScalars=true]
				        ),
				
				    Equivalencies = [
				        Acer = "A",
				        #"Formigó armat retacat" = "B",
				        #"Formigó armat junta soldada" = "BS",
				        #"Fosa dúctil" = "FD",
				        #"Fosa gris" = "FG",
				        #"Ferro galvanitzat" = "GALV",
				        #"Acer inoxidable" = "INOX",
				        #"Polietilè d'alta densitat" = "PEA",
				        #"Polietilè de baixa densitat" = "PEB",
				        #"Polietilè de mitja densitat" = "PEM",
				        #"Polièster reforçat fibra vidre" = "PRFV",
				        #"Policlorur de vinil" = "PVC",
				        #"Policlorur de vinil orientat" = "PVCO",
				        Fibrociment = "U"
				    ],
				
				    #"Codi material afegit" =
				        Table.AddColumn(
				            #"Encabezados promovidos",
				            "tipo_material_Short",
				            each
				                if [Material] = null then null
				                else Record.FieldOrDefault(
				                    Equivalencies,
				                    Text.Trim(Text.From([Material])),
				                    null
				                ),
				            type text
				        ),
				    #"Personalizada agregada" = Table.AddColumn(
				    #"Codi material afegit",
				    "data_inst",
				    each Date.AddDays(
				        Date.From(DateTime.FixedLocalNow()),
				        -Number.Round(
				            Number.From([#"Antiguitat Xarxa (dies)"], "es-ES"),
				            0
				        )
				    ),
				    type date
				),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Personalizada agregada",{{"Divisió", type text}, {"Codi", Int64.Type}, {"Sector", type text}, {"Material", type text}, {"Diàmetre", Int64.Type}, {"Longitud Xarxa (m)", type number}, {"Antiguitat Xarxa (anys)", type number}, {"Antiguitat Xarxa (dies)", type number}, {"tipo_material_Short", type text}, {"data_inst", type date}})
				in
				    #"Tipo cambiado"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

