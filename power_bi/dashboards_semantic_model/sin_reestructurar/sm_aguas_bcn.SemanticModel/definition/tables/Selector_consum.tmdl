			RETURN
			IF(
			    Grupo = "No controlat" && NOT ISBLANK(Tipo),
			    CALCULATE(
			        [kpi_consum_no_control_switch_1m],
			        TREATAS(
			            { Tipo },
			            fact_consum_no_control[tipo_consum]
			        )
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: 7d098354-5db2-4ee2-bdb1-b128f914884d

