table Selector_consum
	lineageTag: e5caf54d-2058-4420-be3b-475ad9dab4ec

	measure kpi_no_control_selector =
			
			VAR Grupo = SELECTEDVALUE(Selector_consum[Grupo])
			VAR Tipo = SELECTEDVALUE(Selector_consum[Tipo])
			RETURN
			IF(
			    Grupo = "No controlat" && NOT ISBLANK(Tipo),
			    CALCULATE(
			        [kpi_consum_no_control_switch],
			        TREATAS(
			            { Tipo },
			            fact_consum_no_control[tipo_consum]
			        )
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: 721ea9fc-3793-4e14-baf8-e114954b4e66

	measure kpi_no_control_selector_1m =
			
			VAR Grupo = SELECTEDVALUE(Selector_consum[Grupo])
