table _switchs
	lineageTag: 5ba8daa4-05a4-4cbd-958b-8be194c426ed

	measure kpi_anr_dia_m3_switch =
			
			VAR _Periodo =
			    SELECTEDVALUE(dummy_slicer_periodo[Periodo]) & ""
			
			VAR _EsContextoMes =
			    ISINSCOPE('dim_calendario'[mes_corto])
			        || ISINSCOPE('dim_calendario'[anio_mes])
			
			VAR _UltimaFechaConDato =
			    MAXX(
			        FILTER(
			            ALLSELECTED('dim_calendario'[Date]),
			            NOT ISBLANK(
			                CALCULATE([anr_dia_m3_mensual])
			            )
			        ),
			        'dim_calendario'[Date]
			    )
			
			RETURN
			SWITCH(
			    _Periodo,
			
			    "Mensual",
			        IF(
			            _EsContextoMes,
			            [anr_dia_m3_mensual],
			            CALCULATE(
			                [anr_dia_m3_mensual],
			                REMOVEFILTERS('dim_calendario'),
			                'dim_calendario'[Date] = _UltimaFechaConDato
			            )
			        ),
			
			    "12 meses",
			        [anr_dia_m3_acum_12m],
			
			    "Acumulat",
			        [anr_dia_m3_ytd],
			
			    "Diff",
			        IF(
			            _EsContextoMes,
			            [anr_dia_m3_diff],
			            VAR _UltimaFechaDiff =
			                MAXX(
			                    FILTER(
			                        ALLSELECTED('dim_calendario'[Date]),
			                        NOT ISBLANK(
			                            CALCULATE([anr_dia_m3_diff])
			                        )
			                    ),
			                    'dim_calendario'[Date]
			                )
			            RETURN
			                CALCULATE(
			                    [anr_dia_m3_diff],
			                    REMOVEFILTERS('dim_calendario'),
			                    'dim_calendario'[Date] = _UltimaFechaDiff
			                )
			        ),
			
			    BLANK()
			)
		displayFolder: anr\dia_m3
		lineageTag: aefdb69b-7672-4b20-bde5-a92f86277203

		annotation PBI_FormatHint = {"isGeneralNumber":true}

