	measure kpi_anr_l_esc_dia_switch = ```
			
			VAR _Periodo =
			    SELECTEDVALUE(dummy_slicer_periodo[Periodo]) & ""
			
			VAR _EsContextoMes =
			    ISINSCOPE('dim_calendario'[mes_corto])
			        || ISINSCOPE('dim_calendario'[anio_mes])
			
			VAR _UltimaFechaConDatoMensual =
			    MAXX(
			        FILTER(
			            ALLSELECTED('dim_calendario'),
			            NOT ISBLANK(
			                CALCULATE([anr_l_esc_dia_mensual])
			            )
			        ),
			        'dim_calendario'[Date]
			    )
			
			VAR _UltimoValorMensual =
			    CALCULATE(
			        [anr_l_esc_dia_mensual],
			        REMOVEFILTERS('dim_calendario'),
			        'dim_calendario'[Date] = _UltimaFechaConDatoMensual
			    )
			
			RETURN
			SWITCH(
			    _Periodo,
			
			    "Mensual",
			        IF(
			            _EsContextoMes,
			            [anr_l_esc_dia_mensual],
			            _UltimoValorMensual
			        ),
			
			    "12 meses",
			        [anr_l_esc_dia_acum_12m],
			
			    "Acumulat", [anr_l_esc_dia_ytd],
			    
			    "Diff", [anr_l_esc_dia_diff],
			
			    BLANK()
			)
			```
		formatString: #,0.00
