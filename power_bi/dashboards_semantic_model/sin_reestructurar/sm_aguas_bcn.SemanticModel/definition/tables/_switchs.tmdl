	measure Metrica_Mapa_Seleccionada = ```
			
			VAR MetricaElegida = SELECTEDVALUE(Slicer_KPI[Metrica], "Rendimiento (%)")
			VAR Periodoelegido = SELECTEDVALUE(dummy_slicer_periodo[Periodo], "Mensual")
			RETURN
			    SWITCH(
			        MetricaElegida,
			        "ANR (m³)",
			            IF(Periodoelegido = "12 meses", [anr_acum_12m], [anr_mensual]),
			        "Rendimiento (%)",
			            IF(Periodoelegido = "12 meses", [rth_distribucion_12m], [rth_distribucion_mensual]),
			        "Caudal Mínimo Nocturno",
			            IF(Periodoelegido = "12 meses", [q_min_12_mesos_mitjana], [q_min_mensual]),
			        "Fraudes Detectados", 
			            [fraus_detectats],
			        [rth_distribucion_mensual] // Valor por defecto, aqui solo se pueden meter valores numericos
			    )
			```
		lineageTag: 13cddcb7-0eef-4f96-93e4-a3a594f46a48

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure kpi_selected_map = SELECTEDVALUE(Slicer_KPI[Metrica], "Rendimiento (%)")
		lineageTag: f1331140-57ce-4cef-8a54-8278137f3b0a

	measure Metrica_Color_Mapa =
			
			VAR MetricaElegida = SELECTEDVALUE( Slicer_KPI[Metrica], "Rendimiento (%)" )
			
			VAR Valor = [Metrica_Mapa_Seleccionada]
			
			RETURN
			    SWITCH(
			        TRUE(),
			
			        // =========================
			        // RENDIMIENTO
			        // =========================
			        MetricaElegida = "Rendimiento (%)",
			            SWITCH(
			                TRUE(),
			                Valor < 0.70, "#D7191C",
			                Valor < 0.85, "#F46D43",
			                Valor < 0.95, "#FEE08B",
			                "#1A9641"
			            ),
			
			        // =========================
			        // ANR
			        // =========================
			        MetricaElegida = "ANR (m³)",
			            SWITCH(
			                TRUE(),
			                Valor >= 100000, "#D7191C",
			                Valor >= 50000, "#F46D43",
			                Valor >= 25000, "#FEE08B",
			                "#1A9641"
			            ),
			
			        // =========================
			        // CAUDAL MÍNIMO NOCTURNO
			        // =========================
			        MetricaElegida = "Caudal Mínimo Nocturno",
			            SWITCH(
			                TRUE(),
			                Valor >= 100, "#D7191C",
			                Valor >= 70, "#F46D43",
			                Valor >= 40, "#FEE08B",
			                "#1A9641"
			            ),
			
			        // =========================
			        // FRAUDES
			        // =========================
			        MetricaElegida = "Fraudes Detectados",
			            SWITCH(
			                TRUE(),
			                Valor >= 100, "#D7191C",
			                Valor >= 50, "#F46D43",
			                Valor >= 20, "#FEE08B",
			                "#1A9641"
			            ),
			
			        BLANK()
			    )
		lineageTag: e0c9011f-577e-497e-8f60-dfe5265779dc

	measure kpi_anr_global_switch_1m =
			
			VAR _Periodo =
			    SELECTEDVALUE(dummy_slicer_periodo[Periodo]) & ""
			
			RETURN
			SWITCH(
			    _Periodo,
			
			    "Mensual",
			        [anr_global_mensual_smly_hm3],
			
			    "12 meses",
			        [anr_global_acum_12m_1m_hm3],
			
			    "Acumulat",
			        [anr_global_lytd],
			
			    "Diff",
			        [_cero_acumulat],
			
			    BLANK()
			)
		formatString: #,0.000000
		displayFolder: anr_global\anr
		lineageTag: b73ca3f3-62f3-4dac-a730-77c07f2d0d69

	measure kpi_consumita_global_switch =
			
			VAR _Periodo =
			    SELECTEDVALUE(dummy_slicer_periodo[Periodo]) & ""
			
			VAR _EsContextoMes =
			    ISINSCOPE('dim_calendario'[mes_corto])
			
			RETURN
			SWITCH(
			    _Periodo,
			
			    "Mensual",
			        [volum_consumit_global_mensual_hm3],
			
			    "12 meses",
			        [volum_consumit_global_acum_12m],
			
			    "Acumulat",
			        [volum_consumit_global_ytd],
			
			    "Diff",
			        IF(
			            _EsContextoMes,
			
			            -- Gráfico: diferencia mes a mes
			            [volum_consumit_global_diff],
			
			            -- KPI: último Diff disponible
			            VAR _UltimaFechaConDato =
			                MAXX(
			                    FILTER(
			                        ALLSELECTED('dim_calendario'[Date]),
			                        NOT ISBLANK(
			                            CALCULATE([volum_consumit_global_diff])
			                        )
			                    ),
			                    'dim_calendario'[Date]
			                )
			            RETURN
			                CALCULATE(
			                    [volum_consumit_global_diff],
			                    REMOVEFILTERS('dim_calendario'[Date]),
			                    'dim_calendario'[Date] = _UltimaFechaConDato
			                )
			        ),
			
			    BLANK()
			)
		displayFolder: anr_global\volumns
		lineageTag: 69633d97-baa9-454e-ba3e-6edc694da6c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure kpi_consumita_global_switch_1m =
			
			VAR _Periodo =
