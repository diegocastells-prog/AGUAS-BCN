			    "Mensual", [volum_consumit_global_mensual_smly_hm3],
			    "12 meses", [volum_consumit_global_acum_12m_1m_hm3],
			    "Acumulat", [volum_consumit_global_lytd],
			    "Diff", [_cero_acumulat],
			    BLANK()
			)
		displayFolder: anr_global\volumns
		lineageTag: 11d78951-9582-455d-a6cb-69242d37abe7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure kpi_l_global_switch =
			
			VAR _Periodo =
			    SELECTEDVALUE(dummy_slicer_periodo[Periodo]) & ""
			
			VAR _EsContextoMes =
			    ISINSCOPE('dim_calendario'[mes_corto])
			
			VAR _UltimaFechaConDato =
			    MAXX(
			        FILTER(
			            ALLSELECTED('dim_calendario'),
			            NOT ISBLANK(
			                CALCULATE([l_km_mensual])
			            )
			                && CALCULATE([l_km_mensual]) <> 0
			        ),
			        'dim_calendario'[Date]
			    )
			
			VAR _UltimoValorDisponible =
			    CALCULATE(
			        [l_km_mensual],
			        REMOVEFILTERS('dim_calendario'),
			        'dim_calendario'[Date] = _UltimaFechaConDato
			    )
			
			RETURN
			SWITCH(
			    _Periodo,
			
			    "Mensual",
			        IF(
			            _EsContextoMes,
			            COALESCE(
			                [l_km_mensual],
			                _UltimoValorDisponible
			            ),
			            _UltimoValorDisponible
			        ),
			
			    "12 meses",
			        [l_km_12m_mitjana],
			
			    "Acumulat",
			        [l_km_global_ytd],
			
			    "Diff",
			        IF(
			            _EsContextoMes,
			            [l_km_diff],
			
			            VAR _UltimaFechaConDiff =
			                MAXX(
			                    FILTER(
			                        ALLSELECTED('dim_calendario'),
			                        NOT ISBLANK(
			                            CALCULATE([l_km_diff])
			                        )
			                    ),
			                    'dim_calendario'[Date]
			                )
			            RETURN
			                CALCULATE(
			                    [l_km_diff],
			                    REMOVEFILTERS('dim_calendario'),
			                    'dim_calendario'[Date] = _UltimaFechaConDiff
			                )
			        ),
			
			    BLANK()
			)
		displayFolder: anr_global\l
		lineageTag: e140d3f6-46aa-412f-b626-fe4223411fa9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

