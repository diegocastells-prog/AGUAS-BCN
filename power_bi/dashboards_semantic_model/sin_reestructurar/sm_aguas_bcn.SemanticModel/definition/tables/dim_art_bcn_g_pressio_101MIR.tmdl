				    #"Columnas con nombre cambiado1" = Table.RenameColumns(#"Tipo cambiado1",{{"iden", "nº_de_nudo"}, {"zeta", "z(m)"}, {"profunditats", "profundidad(m)"}, {"sector", "zona_2"}, {"grup_pressio_4", "grup_pressio_dia"}, {"grup_pressio", "grup_pressio_nit"}, {"compleix?", "complim?"}}),
				    #"Tipo cambiado3" = Table.TransformColumnTypes(#"Columnas con nombre cambiado1",{{"zona_2", type number}})
