table _switch
	lineageTag: 21400e39-73d1-4b86-8b2b-ce86abeeb315

	measure kpi_value = ```
			
			VAR _kpi = SELECTEDVALUE('_switch'[kpi], "NONE")
			VAR _valor = SELECTEDVALUE('_switch'[valor], "NONE")
			RETURN
			    SWITCH(
			        TRUE(),
			        // ========== ANR Global (hm3) ==========
			        _kpi = "ANR Global (hm3)" && _valor = "MENSUAL", 
			            SUM('fact_anr_global_mensual'[anr_global_hm3]),
			        
			        _kpi = "ANR Global (hm3)" && _valor = "ACUM 12 MESES", 
			            SUM('fact_anr_global_acum'[anr_global_hm3]),
			        
			        // ========== ANR/día (m3) ==========
			        _kpi = "ANR/día (m3)" && _valor = "MENSUAL", 
			            [anr_dia_m3_mensual],
			        
			        _kpi = "ANR/día (m3)" && _valor = "ACUM 12 MESES", 
			            [anr_dia_m3_12m],
			        
			        // ========== ANR (l/esc/día) ==========
			        _kpi = "ANR (l/esc/día)" && _valor = "MENSUAL", 
			            [anr_l_esc_dia_mensual],
			        
			        _kpi = "ANR (l/esc/día)" && _valor = "ACUM 12 MESES", 
			            [anr_l_esc_dia_12m],
			        
			        // ========== ANR (l/subm/día) ==========
			        _kpi = "ANR (l/subm/día)" && _valor = "MENSUAL", 
			            [anr_l_subm_dia_mensual],
			        
			        _kpi = "ANR (l/subm/día)" && _valor = "ACUM 12 MESES", 
			            [anr_l_subm_dia_12m],
			        
			        // ========== ANR (m3/km/día) ==========
			        _kpi = "ANR (m3/km/día)" && _valor = "MENSUAL", 
			            [anr_m3_km_dia_mensual],
			        
			        _kpi = "ANR (m3/km/día)" && _valor = "ACUM 12 MESES", 
			            [anr_m3_km_dia_12m],
			        
			        // ========== Aigua Lliurada (hm3) ==========
			        _kpi = "Aigua Lliurada (hm3)" && _valor = "MENSUAL", 
			            SUM('fact_anr_global_mensual'[lliurada_hm3]),
			        
			        _kpi = "Aigua Lliurada (hm3)" && _valor = "ACUM 12 MESES", 
			            SUM('fact_anr_global_acum'[lliurada_hm3]),
			        
			        // ========== Aigua Consumida (hm3) ==========
			        _kpi = "Aigua Consumida (hm3)" && _valor = "MENSUAL", 
			            SUM('fact_anr_global_mensual'[consumida_hm3]),
			        
			        _kpi = "Aigua Consumida (hm3)" && _valor = "ACUM 12 MESES", 
			            SUM('fact_anr_global_acum'[consumida_hm3]),
			        
			        // ========== RTH Global ==========
			        _kpi = "RTH Global" && _valor = "MENSUAL", 
			            SUM('fact_anr_global_mensual'[rth_global]),
			        
			        _kpi = "RTH Global" && _valor = "ACUM 12 MESES", 
			            SUM('fact_anr_global_acum'[rth_global]),
			        
			        // Default
			        BLANK()
			    )
			```
		lineageTag: dd6392d9-c168-43dc-b367-13a36d25f152

		annotation PBI_FormatHint = {"isGeneralNumber":true}

