	column _gerencia
		dataType: string
		lineageTag: c3d43d6d-22d7-4aa2-a12c-65ffd4a40c42
		summarizeBy: none
		sourceColumn: _gerencia

		annotation SummarizationSetBy = Automatic

	column Fecha
		dataType: dateTime
		formatString: Long Date
		lineageTag: d9dc9c69-8d83-49eb-9ca1-63d0635f6b67
		summarizeBy: none
		sourceColumn: Fecha

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column categoria
		dataType: string
		lineageTag: dfcf1d16-62d3-4b52-9add-48eefaba7bd8
		summarizeBy: none
		sourceColumn: categoria

