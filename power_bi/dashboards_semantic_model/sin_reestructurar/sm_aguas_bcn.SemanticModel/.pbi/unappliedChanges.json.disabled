      "text": [
        "let",
        "        Origen = GoogleSheets.Contents(ActuacionsZones2024_D),",
        "        #\"RESUM ACTUACIONS_Table\" = Origen{[name=\"REPARACIONS\",ItemKind=\"Table\"]}[Data],",
