      "text": [
        "let",
        "    Origen = GoogleSheets.Contents(Cabalimetros),",
        "    Datos = Origen{[name = \"Cabalímetres\", ItemKind = \"Table\"]}[Data],",
        " ",
        "    Encabezados = Table.PromoteHeaders(",
        "        Datos,",
        "        [PromoteAllScalars = true]",
        "    ),",
        " ",
        "    ColumnasRenombradas = Table.RenameColumns(",
        "        Encabezados,",
        "        {",
        "            {\"\", \"gerencia\"},",
        "            {\"ID\", \"id\"},",
        "            {\"Gerència\", \"cod_gerenciapc\"},",
        "            {\"Tipus Equip\", \"tipus_equip\"},",
        "            {\"Fabricant\", \"fabricante\"},",
        "            {\"Diàmetre\", \"diametre_mm\"},",
        "            {\"Data Instal·lació\", \"data_instal\"},",
        "            {\"Any Instal·lació\", \"any_instal\"}",
        "        }",
        "    ),",
        " ",
        "    ColumnasNecesarias = Table.SelectColumns(",
        "        ColumnasRenombradas,",
        "        {",
        "            \"gerencia\",",
        "            \"id\",",
        "            \"cod_gerenciapc\",",
        "            \"tipus_equip\",",
        "            \"fabricante\",",
        "            \"diametre_mm\",",
        "            \"data_instal\",",
        "            \"any_instal\"",
        "        }",
        "    ),",
        " ",
        "    Tipos = Table.TransformColumnTypes(",
        "        ColumnasNecesarias,",
        "        {",
        "            {\"gerencia\", type text},",
        "            {\"id\", type text},",
        "            {\"cod_gerenciapc\", type text},",
        "            {\"tipus_equip\", type text},",
        "            {\"fabricante\", type text},",
        "            {\"diametre_mm\", type text},",
        "            {\"data_instal\", type date},",
        "            {\"any_instal\", Int64.Type}",
        "        }",
        "    ),",
        " ",
        "    TextosLimpios = Table.TransformColumns(",
        "        Tipos,",
        "        {",
        "            {",
        "                \"gerencia\",",
        "                each",
        "                    if _ = null then",
        "                        null",
        "                    else",
        "                        Text.Proper(",
        "                            Text.Clean(",
        "                                Text.Trim(",
        "                                    Text.From(_)",
        "                                )",
        "                            )",
        "                        ),",
        "                type text",
        "            },",
        "            {",
        "                \"id\",",
        "                each",
        "                    if _ = null then",
        "                        null",
        "                    else",
        "                        Text.Proper(",
        "                            Text.Trim(",
        "                                Text.From(_)",
        "                            )",
        "                        ),",
        "                type text",
        "            }",
        "        }",
        "    ),",
        " ",
        "    Diametro = Table.TransformColumns(",
        "        TextosLimpios,",
        "        {",
        "            {",
        "                \"diametre_mm\",",
        "                each",
        "                    try",
        "                        Number.From(",
        "                            Text.BeforeDelimiter(",
        "                                Text.From(_),",
        "                                \"mm\"",
        "                            )",
        "                        )",
        "                    otherwise",
        "                        null,",
        "                type number",
        "            }",
        "        }",
        "    ),",
        " ",
        "    FechaInstalacion = Table.ReplaceValue(",
        "        Diametro,",
        "        null,",
        "        #date(1899, 1, 1),",
        "        Replacer.ReplaceValue,",
        "        {\"data_instal\"}",
        "    ),",
        " ",
        "    FabricanteNormalizado = Table.TransformColumns(",
        "        FechaInstalacion,",
        "        {",
        "            {",
        "                \"fabricante\",",
        "                each",
        "                    let",
        "                        f =",
        "                            if _ = null then",
        "                                \"\"",
        "                            else",
        "                                Text.Trim(Text.From(_)),",
        "                        fl = Text.Lower(f)",
        "                    in",
        "                        if f = \"\" then",
        "                            \"No Disponible\"",
        "                        else if",
        "                            Text.StartsWith(fl, \"siemens\")",
        "                            or fl = \"siemmens\"",
        "                            or fl = \"sitrans\"",
        "                        then",
        "                            \"Siemens\"",
        "                        else if",
        "                            fl = \"waterflux\"",
        "                            or fl = \"krone\"",
        "                            or fl = \"krhone\"",
        "                        then",
        "                            \"Krohne\"",
        "                        else if",
        "                            List.Contains(",
        "                                {",
        "                                    \"endress & hauser\",",
        "                                    \"endress+hausen\",",
        "                                    \"endress hauser\",",
        "                                    \"endress+hauser\"",
        "                                },",
        "                                fl",
        "                            )",
        "                        then",
        "                            \"Endress + Hauser\"",
        "                        else if",
        "                            Text.Contains(fl, \"isomag\")",
        "                            or Text.Contains(fl, \"isoil\")",
        "                        then",
        "                            \"Isoil\"",
        "                        else if fl = \"xx\" then",
        "                            \"No Disponible\"",
        "                        else",
        "                            Text.Proper(f),",
        "                type text",
        "            }",
        "        }",
        "    ),",
        " ",
        "    GerenciaJoin = Table.NestedJoin(",
        "        FabricanteNormalizado,",
        "        {\"gerencia\"},",
        "        dim_gerencia,",
        "        {\"gerencia\"},",
        "        \"dim_gerencia\",",
        "        JoinKind.LeftOuter",
        "    ),",
        " ",
        "    GerenciaExpandida = Table.ExpandTableColumn(",
        "        GerenciaJoin,",
        "        \"dim_gerencia\",",
        "        {\"gerencia_id\"},",
        "        {\"gerencia_id\"}",
        "    ),",
        " ",
        "    GerenciaEliminada = Table.RemoveColumns(",
        "        GerenciaExpandida,",
        "        {\"gerencia\"}",
        "    ),",
        " ",
        "    FilasOrdenadas = Table.Sort(",
        "        GerenciaEliminada,",
        "        {{\"id\", Order.Ascending}}",
        "    ),",
        " ",
        "    CabalimetroClaval = Table.SelectRows(",
        "        FilasOrdenadas,",
        "        each [id] <> \"Claval\"",
        "    ),",
        " ",
        "    RegulacionJoin = Table.NestedJoin(",
        "        CabalimetroClaval,",
        "        {\"cod_gerenciapc\"},",
        "        dim_aux_tipus_reg_cabali,",
        "        {\"cod_gerenciapc\"},",
        "        \"dim_aux_tipus_reg_cabali\",",
        "        JoinKind.LeftOuter",
        "    ),",
        " ",
        "    RegulacionExpandida = Table.ExpandTableColumn(",
        "        RegulacionJoin,",
        "        \"dim_aux_tipus_reg_cabali\",",
        "        {\"tipus_regulac\"},",
        "        {\"tipus_regulac\"}",
        "    ),",
        " ",
        "    RegulacionDefault = Table.ReplaceValue(",
        "        RegulacionExpandida,",
        "        null,",
        "        \"Medidor\",",
        "        Replacer.ReplaceValue,",
        "        {\"tipus_regulac\"}",
        "    ),",
        " ",
        "    Resultado = Table.ReorderColumns(",
        "        RegulacionDefault,",
        "        {",
        "            \"cod_gerenciapc\",",
        "            \"id\",",
        "            \"gerencia_id\",",
        "            \"tipus_equip\",",
        "            \"tipus_regulac\",",
        "            \"fabricante\",",
        "            \"diametre_mm\",",
        "            \"data_instal\",",
        "            \"any_instal\"",
        "        }",
        "    ),",
        " ",
        "    ResultadoFinal = Table.RenameColumns(",
        "        Resultado,",
        "        {",
        "            {\"id\", \"id_cabalimetro\"}",
        "        }",
        "    )",
        " ",
        "in",
        "    ResultadoFinal"
      ],
