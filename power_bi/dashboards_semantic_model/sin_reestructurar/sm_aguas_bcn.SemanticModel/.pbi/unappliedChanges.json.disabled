        "                {\"v12_en_m3\", type number},",
        "                {\"períodes_amb_estimades\", Int64.Type}",
        "            }",
        "        ),",
        "",
        "    Limpieza =",
        "        Table.TransformColumns(",
        "            Tipos,",
        "            {",
        "                {",
        "                    \"sector\",",
        "                    each if _ = \"\" then null else _,",
        "                    type nullable text",
        "                },",
        "                {",
        "                    \"rendiment_sector_(maig_2026)\",",
        "                    each if _ = \"\" then null else _,",
        "                    type nullable number",
        "                },",
        "                {",
        "                    \"dn_limitador\",",
        "                    each if _ = \"\" or _ = \"-\" then null else _,",
        "                    type nullable text",
        "                }",
        "            }",
        "        ),",
        "",
        "    SinDuplicados =",
        "        Table.Distinct(Limpieza),",
        "",
        "    Resultado =",
        "        Table.SelectRows(",
        "            SinDuplicados,",
        "            each List.NonNullCount(Record.FieldValues(_)) > 0",
        "        )",
        "",
        "in",
        "    Resultado"
      ],
      "loadAsTableDisabled": true,
      "resultType": "Table",
      "isHidden": false
    },
    {
      "name": "Bossa_de_Limitadors_BCNS",
      "lineageTag": "10e00cc1-e4c4-4532-8c9a-492394f79c96",
      "queryGroupId": "b9cb89a4-da8c-4f41-8b5e-2498d9d85e0d",
      "navigationStepName": "Navegación",
      "text": [
        "//",
        "",
        "// ESTA FACT SE GENERA A PARTIR DEL ARCHIVO DE GOOGLE DRIVE ",
        "",
        "//            Bossa de Limitadors_Canvis per DOP ",
        "",
        "// PESTAÑA:",
        "",
        "//              BCNS",
        "",
        "",
        "let",
        "  Origen = GoogleSheets.Contents(\"https://docs.google.com/spreadsheets/d/1G9GggBeQbtbK0kD-I7o1ypbgcIGSwQGkRXSvvtn8MaE/edit?gid=1640328521#gid=1640328521\"),",
        "     BCNS_Table = Origen{[name=\"BCNS\", ItemKind=\"Table\"]}[Data],",
        "",
        "    Encabezados =",
        "        Table.PromoteHeaders(BCNS_Table, [PromoteAllScalars=true]),",
        "",
        "    Columnas =",
        "        Table.TransformColumnNames(",
        "            Encabezados,",
        "            each Text.Replace(Text.Lower(_), \" \", \"_\")",
        "        ),",
        "",
        "    Renombradas =",
        "        Table.RenameColumns(",
        "            Columnas,",
        "            {",
        "                {\"data_instal·lació\", \"data_instalacion\"},",
        "                {\"estratègic\", \"estrategic\"}",
        "            }",
        "        ),",
        "",
        "    Texto =",
        "        Table.TransformColumns(",
        "            Renombradas,",
        "            {",
        "                {\"sector\", Text.Proper, type text},",
        "                {\"prioritat\", Text.Proper, type text}",
        "            }",
        "        ),",
        "",
        "    Seleccionadas =",
        "        Table.SelectColumns(",
        "            Texto,",
        "            {",
        "                \"dop\",",
        "                \"sector\",",
        "                \"rendiment_sector_(maig_2026)\",",
        "                \"polissa_subm\",",
        "                \"tipus_subm\",",
        "                \"data_instalacion\",",
        "                \"edat_comp\",",
        "                \"diam_comp\",",
        "                \"dn_limitador\",",
        "                \"data_alta_subm\",",
        "                \"consum_mig_dia\",",
        "                \"consum_anual_estimat\",",
        "                \"estrategic\",",
        "                \"prioritat\",",
        "                \"necessitat\",",
        "                \"v12_en_m3\",",
        "                \"períodes_amb_estimades\"",
        "            }",
        "        ),",
        "",
        "     SinErrores =",
        "        Table.ReplaceErrorValues(",
        "            Seleccionadas,",
        "            List.Transform(Table.ColumnNames(Seleccionadas), each {_, null})",
        "        ),",
        "",
        "    LimpiezaInicial =",
        "        Table.ReplaceValue(",
        "            Table.ReplaceValue(",
        "                SinErrores,",
        "                \"-\",",
        "                null,",
        "                Replacer.ReplaceValue,",
        "                {\"dn_limitador\"}",
        "            ),",
        "            \"\",",
        "            null,",
        "            Replacer.ReplaceValue,",
        "            {\"dn_limitador\"}",
        "        ),",
        "",
        "    Tipos =",
        "        Table.TransformColumns(",
        "            LimpiezaInicial,",
        "            {",
        "                {\"rendiment_sector_(maig_2026)\", each try Number.From(_) otherwise null, type nullable number},",
        "                {\"polissa_subm\", each _, type text},",
        "                {\"data_instalacion\", each try Date.From(_) otherwise null, type nullable date},",
        "                {\"edat_comp\", each try Int64.From(_) otherwise null, Int64.Type},",
        "                {\"diam_comp\", each try Int64.From(_) otherwise null, Int64.Type},",
        "                {\"data_alta_subm\", each try Date.From(_) otherwise null, type nullable date},",
        "                {\"consum_mig_dia\", each try Number.From(_) otherwise null, type nullable number},",
        "                {\"consum_anual_estimat\", each try Number.From(_) otherwise null, type nullable number},",
        "                {\"estrategic\", each _, type text},",
        "                {\"necessitat\", each _, type text},",
        "                {\"v12_en_m3\", each try Number.From(_) otherwise null, type nullable number},",
        "                {\"períodes_amb_estimades\", each try Int64.From(_) otherwise null, Int64.Type},",
        "                {\"dop\", each _, type text},",
        "                {\"dn_limitador\", each try Int64.From(_) otherwise null, Int64.Type}",
        "            }",
        "        ),",
        "",
        "    Limpieza =",
        "        Table.TransformColumns(",
        "            Tipos,",
        "            {",
        "                {",
        "                    \"sector\",",
        "                    each",
        "                        let v = if _ = \"\" then null else _",
        "                        in if v = \"Not Available\" then null else v,",
        "                    type nullable text",
        "                }",
        "            }",
        "        ),",
        "",
        "    SinDuplicados =",
        "        Table.Distinct(Limpieza),",
        "",
        "    Resultado =",
        "        Table.SelectRows(",
        "            SinDuplicados,",
        "            each List.NonNullCount(Record.FieldValues(_)) > 0",
        "        )",
        "",
        "in ",
        " Resultado"
      ],
      "loadAsTableDisabled": true,
      "resultType": "Table",
      "isHidden": false
    },
    {
      "name": "fact_volum_lliurat",
      "lineageTag": "1c9b8728-02b5-446c-9fb9-ee6278206a92",
      "queryGroupId": "941e837f-8d28-4385-b105-24b957158089",
      "navigationStepName": "Navegación",
      "text": [
        "let",
        "  Origen = GoogleSheets.Contents(\"https://docs.google.com/spreadsheets/d/1ZffEmnNoWOUZV2BWTDYGZTjcNVbZ07il0J7N43DN_IU/edit?gid=512415232#gid=512415232\"),",
        "  TablaOrigen = Origen{[name = \"Lliurats Corregits\", ItemKind = \"Table\"]}[Data],",
        "",
        "    // Preparación de datos",
        "    SaltarFilas = Table.Skip(TablaOrigen, 2),",
        "    PromoverEncabezados = Table.PromoteHeaders(SaltarFilas, [PromoteAllScalars = true]),",
        "    #\"Filas filtradas2\" = Table.SelectRows(PromoverEncabezados, each ([Nº] <> \"\")),",
        "    // Eliminar columnas innecesarias",
        "    EliminarColumnas = Table.RemoveColumns(",
        "        #\"Filas filtradas2\",",
        "        {",
        "            \"_1\", \"\"",
        "        }",
        "    ),",
        "    #\"Filas filtradas\" = Table.SelectRows(EliminarColumnas, each ([Gerència] <> \"Total\") and ([Pis Pressió] <> \"Aigua Lliurada Total\" and [Pis Pressió] <> \"Aigua Lliurada Íntegre\")),",
        "    // Pasar las fechas a filas",
        "    DespivotarFechas = Table.UnpivotOtherColumns(",
        "        #\"Filas filtradas\",",
        "        {\"Nº\", \"Gerència\", \"Pis Pressió\", \"Sectors\"},",
        "        \"fecha\",",
        "        \"volum_lliurat\"",
        "    ),",
        "    #\"Errores reemplazados\" = Table.ReplaceErrorValues(DespivotarFechas, {{\"volum_lliurat\", 0}}),",
        "",
        "    // Renombrar columnas",
        "    RenombrarColumnas = Table.RenameColumns(",
        "        #\"Errores reemplazados\",",
        "        {",
        "            {\"Nº\", \"sector_id\"},",
        "            {\"Gerència\", \"gerencia\"},",
        "            {\"Pis Pressió\", \"pis_pressio\"}",
        "        }",
        "    ),",
        "",
        "    // Asignar tipos de datos",
        "    CambiarTipos = Table.TransformColumnTypes(",
        "        RenombrarColumnas,",
        "        {",
        "            {\"sector_id\", Int64.Type},",
        "            {\"gerencia\", type text},",
        "            {\"pis_pressio\", type text},",
        "            {\"fecha\", type date},",
        "            {\"volum_lliurat\", Int64.Type}",
        "        }",
        "    ),",
        "",
        "    // Limpiar datos",
        "    SinDuplicados = Table.Distinct(CambiarTipos),",
        "    SinFilasVacias = Table.SelectRows(",
        "        SinDuplicados,",
        "        each List.NonNullCount(Record.FieldValues(_)) > 0",
        "    ),",
        "    #\"Valor reemplazado\" = Table.ReplaceValue(SinFilasVacias,\"\",\"No Disponible\",Replacer.ReplaceValue,{\"gerencia\"}),",
        "    #\"Filas filtradas1\" = Table.SelectRows(#\"Valor reemplazado\", each true),",
        "    #\"Texto limpio\" = Table.TransformColumns(#\"Filas filtradas1\",{{\"gerencia\", Text.Clean, type text}}),",
        "    #\"Texto recortado\" = Table.TransformColumns(#\"Texto limpio\",{{\"gerencia\", Text.Trim, type text}}),",
        "    #\"Consultas combinadas\" = Table.NestedJoin(#\"Texto recortado\", {\"gerencia\"}, dim_gerencia, {\"gerencia\"}, \"dim_gerencia\", JoinKind.LeftOuter),",
        "    #\"Se expandió dim_gerencia\" = Table.ExpandTableColumn(#\"Consultas combinadas\", \"dim_gerencia\", {\"gerencia_id\"}, {\"gerencia_id\"}),",
        "    #\"Valor reemplazado1\" = Table.ReplaceValue(#\"Se expandió dim_gerencia\",\"\",\"No Disponible\",Replacer.ReplaceValue,{\"Sectors\"}),",
        "    #\"Valor reemplazado2\" = Table.ReplaceValue(#\"Valor reemplazado1\",null,-1,Replacer.ReplaceValue,{\"sector_id\"})",
        "in",
        "    #\"Valor reemplazado2\""
      ],
      "loadAsTableDisabled": true,
      "resultType": "Table",
      "isHidden": false
    },
    {
      "name": "aux_dim_sector",
      "lineageTag": "0ba75a1c-eda2-431e-ae33-5ccddeecbae2",
      "queryGroupId": "941e837f-8d28-4385-b105-24b957158089",
      "navigationStepName": "Navegación",
      "text": [
        "// TABLA 1 -Coordenadas",
        "",
        "let ",
        "    Origen1 = GoogleSheets.Contents(\"https://docs.google.com/spreadsheets/d/1l9btpQJf9bOrnwWyDpkAZpQXill8mdHHxKlHcdf_DVQ/edit?gid=1726033904#gid=1726033904\"), ",
        "    Nav1 = Origen1{[name = \"coordenadas por sector bcn.csv\", ",
        "    ItemKind = \"Table\"]}[Data], ",
        "    Quitadas = Table.RemoveColumns(Nav1,{\"Column1\", \"Column2\", \"Column3\"}), ",
        "    Headers1 = Table.PromoteHeaders(Quitadas, [PromoteAllScalars=true]),",
        "    Tipos1 = Table.TransformColumnTypes(Headers1,{{\"sector_id\", Int64.Type}, {\"latitud\", type number}, {\"longitud\", type number}}), ",
        "    SinDuplicados = Table.Distinct(Tipos1), ",
        "    Coordenadas = Table.SelectRows(SinDuplicados, each List.NonNullCount(Record.FieldValues(_)) > 0),",
        "// TABLA 2 - Sectores ",
        "    Origen2 = Csv.Document(Web.Contents(\"https://docs.google.com/spreadsheets/d/e/2PACX-1vRH4WiST8QUNFuYRZ1ilIw7p1mfJMiAz5bImbBz2ffnYgrxn2MyRB5O192pgqrP_SyFQdf6CJroUA9G/pub?gid=0&single=true&output=csv\"), [Delimiter = \",\", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.None]), ",
        "    Headers2 = Table.PromoteHeaders(Origen2, [PromoteAllScalars = true]),",
        "    Tipos2 = Table.TransformColumnTypes(Headers2, {{\"sector_id\", Int64.Type}, {\"denomin\", type text}, {\"gerencia\", type text}}, \"es\"), ",
        "    Renombrada = Table.RenameColumns(Tipos2,{{\"denomin\", \"sector\"}}), ",
        "    Sectores = Table.TransformColumns(Renombrada, {{\"sector\", Text.Proper, type text}}),",
        "    // UNION",
        "    Join = Table.NestedJoin( Coordenadas, {\"sector_id\"},Sectores, {\"sector_id\"},\"Sectores\", JoinKind.LeftOuter ),",
        "    Resultado = Table.ExpandTableColumn( Join, \"Sectores\", {\"sector\", \"gerencia\"}, {\"sector\", \"gerencia\"} ),",
        "    #\"Valor reemplazado\" = Table.ReplaceValue(Resultado,null,\"No Disponible\",Replacer.ReplaceValue,{\"gerencia\"}),",
        "    auxiliar =",
        "    Table.Combine({",
        "        #\"Valor reemplazado\",",
        "        dim_sector_aux",
        "    }),",
        "    #\"Columnas quitadas\" = Table.RemoveColumns(auxiliar,{\"gerencia\"})",
        "in",
        "    #\"Columnas quitadas\""
      ],
      "loadAsTableDisabled": true,
      "resultType": "Table",
      "isHidden": false
    },
    {
      "name": "dim_sector_aux",
      "lineageTag": "f24b549f-b8a8-4034-9cf3-cf746d84f092",
      "queryGroupId": "941e837f-8d28-4385-b105-24b957158089",
      "navigationStepName": "Navegación",
      "text": [
        "let",
        "    Origen =",
        "        #table(",
        "            type table [",
        "                sector_id = Int64.Type,",
        "                sector = text,",
        "                gerencia = text",
        "            ],",
        "            {",
        "                {-1, \"No Disponible\", \"No Disponible\"}",
        "            }",
        "        )",
        "in",
        "    Origen"
      ],
      "loadAsTableDisabled": true,
      "resultType": "Table",
      "isHidden": false
    },
    {
      "name": "aux_sector_no_disp",
      "lineageTag": "cbac59f6-5a89-46bc-a8f3-66d34f006385",
      "queryGroupId": "941e837f-8d28-4385-b105-24b957158089",
      "navigationStepName": "Navegación",
      "text": [
        "let",
        "    Origen = Table.FromRows(",
        "        Json.Document(",
        "            Binary.Decompress(",
        "                Binary.FromText(\"i45W0jVU0lHyy1dwySwuyM/LTMpJBfIJIrAuEIqNBQA=\", BinaryEncoding.Base64),",
        "                Compression.Deflate",
        "            )",
        "        ),",
        "        let _t = ((type nullable text) meta [Serialized.Text = true])",
        "        in type table [",
        "            sector_id = _t,",
        "            sector = _t,",
        "            pressio = _t,",
        "            long_xarxa = _t,",
        "            ramals_controlats = _t,",
        "            subministraments_controlats = _t,",
        "            pressio_mitjana = _t,",
        "            lambert = _t,",
        "            afor_l_s = _t,",
        "            referencia = _t,",
        "            sector_activo = _t,",
        "            _1 = _t,",
        "            _2 = _t,",
        "            gerencia_id =_t,",
        "            latitud = _t,",
        "            longitud = _t",
        "        ]",
        "    ),",
        "    Agregados =",
        "    Table.InsertRows(",
        "        Origen,",
        "        Table.RowCount(Origen),",
        "        {",
        "            [sector_id=\"3073\", sector=\"Canyelles\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=8, latitud=null, longitud=null],",
        "            [sector_id=\"3290\", sector=\"Depuradora\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=8, latitud=null, longitud=null],",
        "            [sector_id=\"3166\", sector=\"Ferran Junoy\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=1, latitud=null, longitud=null],",
        "            [sector_id=\"3400\", sector=\"Gornal\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=5, latitud=null, longitud=null],",
        "            [sector_id=\"3221\", sector=\"Indústria\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=2, latitud=null, longitud=null],",
        "            [sector_id=\"3241\", sector=\"La Vallensana\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=3, latitud=null, longitud=null],",
        "            [sector_id=\"3444\", sector=\"Passeig De Sant Gervasi\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=2, latitud=null, longitud=null],",
        "            [sector_id=\"3308\", sector=\"Plaça Barraquer\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=2, latitud=null, longitud=null],",
        "            [sector_id=\"3319\", sector=\"Santa Rosa\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=3, latitud=null, longitud=null],",
        "            [sector_id=\"3354\", sector=\"Santelvira\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=3, latitud=null, longitud=null],",
        "            [sector_id=\"3004\", sector=\"Tibidabo Torreó\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=2, latitud=null, longitud=null],",
        "            [sector_id=\"3313\", sector=\"Sant Just Centre\", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=5, latitud=null, longitud=null]",
        "        }",
        "        ),",
        "   ",
        "   #\"Tipo cambiado\" =",
        "    Table.TransformColumnTypes(",
        "        Agregados,",
        "        {{\"gerencia_id\", Int64.Type}}",
        "    ),",
        "",
        "    #\"Reemplazar\" =",
        "        Table.ReplaceValue(",
        "            #\"Tipo cambiado\",",
        "            -1,",
        "            8,",
        "            Replacer.ReplaceValue,",
        "            {\"gerencia_id\"}",
        "        ),",
        "    #\"Valor reemplazado\" =",
        "    Table.ReplaceValue(",
        "        Reemplazar,",
        "        \"\",",
        "        null,",
        "        Replacer.ReplaceValue,",
        "        Table.ColumnNames(Reemplazar)",
        "    )",
        "    ",
        "    in",
        "        #\"Valor reemplazado\""
      ],
      "loadAsTableDisabled": true,
