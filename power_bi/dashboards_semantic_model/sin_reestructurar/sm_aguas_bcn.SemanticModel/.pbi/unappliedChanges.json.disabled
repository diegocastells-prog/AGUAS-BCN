        "let",
        "    // 1. Unir las tablas",
        "    Union = Table.Combine({",
        "        fact_actuacions_zones_2026, fact_actuacions_zones_2025, fact_actuacions_zones_2024,",
        "        fact_reparacions_zones_2026, fact_reparacions_zones_2025, fact_reparacions_zones_2024",
        "    }),",
        "",
        "    // 2. Agrupar el reemplazo de nulos por \"No Disponible\" en todas las columnas de texto a la vez",
        "    NulosTexto = Table.ReplaceValue(",
        "        Union, ",
        "        null, ",
        "        \"No Disponible\", ",
        "        Replacer.ReplaceValue, ",
        "        {\"descripcio\", \"cerca_activa\", \"tipus_recerca\", \"ubicacio_fuita\"}",
        "    ),",
        "",
        "    // 3. Función optimizada: Ahora también absorbe los valores extraños de \"ordre\" de forma segura",
        "    LimpiarNumero = (num as any) as any =>",
        "        let",
        "            // Controlamos si viene un null real para que Text.From no dé error",
        "            txt = if num = null then \"\" else Text.Trim(Text.From(num))",
        "        in",
        "            // Añadimos \"Interior\" para ahorrarte los 4 pasos manuales que tenías antes",
        "            if txt = \"\" or txt = \"--\" or txt = \",\" or txt = \"null\" or txt = \"Interior\" then 0 else num,",
        "",
        "    // 4. Aplicar limpieza de basura numérica en un solo paso",
        "    BasuraNumericaCero = Table.TransformColumns(NulosTexto, {",
        "        {\"cabal_recuperat\", LimpiarNumero},",
        "        {\"ordre\", LimpiarNumero}",
        "    }),",
        "",
        "    // 5. Reemplazo de nulos a -1 específico para sector_id",
        "    SectorIdNulos = Table.ReplaceValue(BasuraNumericaCero, null, -1, Replacer.ReplaceValue, {\"sector_id\"}),",
        "",
        "    // 6. Cambiar el tipo de dato final de las columnas numéricas",
        "    TiposCambiados = Table.TransformColumnTypes(SectorIdNulos, {",
        "        {\"cabal_recuperat\", type number},",
        "        {\"ordre\", Int64.Type},",
        "        {\"sector_id\", Int64.Type},",
        "        {\"km_inspeccionats_heli\", type number},",
        "        {\"km_inspeccionats_acustic\", type number},",
        "        {\"fuites_reparades_heli\", type number},",
        "        {\"fuites_reparades_acustic\", type number},",
        "        {\"fuites_reparades_altres\", type number},",
        "        {\"maniobres_realitzades\", type number}",
        "    }),",
        "",
        "    // 7. Un único paso masivo para reemplazar TODOS los nulos por 0 en las columnas numéricas",
        "    NumerosNulosCero = Table.ReplaceValue(",
        "        TiposCambiados, ",
        "        null, ",
        "        0, ",
        "        Replacer.ReplaceValue, ",
        "        {",
        "            \"cabal_recuperat\", \"ordre\", \"km_inspeccionats_heli\", \"km_inspeccionats_acustic\",",
        "            \"fuites_reparades_heli\", \"fuites_reparades_acustic\", \"fuites_reparades_altres\", \"maniobres_realitzades\"",
        "        }",
        "    ),",
        "    #\"Valor reemplazado\" = Table.ReplaceValue(NumerosNulosCero,null,#date(2100, 1, 1),Replacer.ReplaceValue,{\"data_inici\"}),",
        "    #\"Consultas combinadas\" = Table.NestedJoin(#\"Valor reemplazado\", {\"zona\"}, dim_gerencia, {\"gerencia\"}, \"dim_gerencia\", JoinKind.LeftOuter),",
        "    #\"Se expandió dim_gerencia\" = Table.ExpandTableColumn(#\"Consultas combinadas\", \"dim_gerencia\", {\"gerencia_id\"}, {\"gerencia_id\"}),",
        "    #\"Columnas quitadas\" = Table.RemoveColumns(#\"Se expandió dim_gerencia\",{\"zona\"})",
        "in",
        "    #\"Columnas quitadas\""
      ],
      "isDirectQuery": false,
      "lastLoadedAsTableFormulaText": "{\"IncludesReferencedQueries\":false,\"RootFormulaText\":\"let\\n    // 1. Unir las tablas\\n    Union = Table.Combine({\\n        fact_actuacions_zones_2026, fact_actuacions_zones_2025, fact_actuacions_zones_2024,\\n        fact_reparacions_zones_2026, fact_reparacions_zones_2025, fact_reparacions_zones_2024\\n    }),\\n\\n    // 2. Agrupar el reemplazo de nulos por \\\"No Disponible\\\" en todas las columnas de texto a la vez\\n    NulosTexto = Table.ReplaceValue(\\n        Union, \\n        null, \\n        \\\"No Disponible\\\", \\n        Replacer.ReplaceValue, \\n        {\\\"descripcio\\\", \\\"cerca_activa\\\", \\\"tipus_recerca\\\", \\\"ubicacio_fuita\\\"}\\n    ),\\n\\n    // 3. Función optimizada: Ahora también absorbe los valores extraños de \\\"ordre\\\" de forma segura\\n    LimpiarNumero = (num as any) as any =>\\n        let\\n            // Controlamos si viene un null real para que Text.From no dé error\\n            txt = if num = null then \\\"\\\" else Text.Trim(Text.From(num))\\n        in\\n            // Añadimos \\\"Interior\\\" para ahorrarte los 4 pasos manuales que tenías antes\\n            if txt = \\\"\\\" or txt = \\\"--\\\" or txt = \\\",\\\" or txt = \\\"null\\\" or txt = \\\"Interior\\\" then 0 else num,\\n\\n    // 4. Aplicar limpieza de basura numérica en un solo paso\\n    BasuraNumericaCero = Table.TransformColumns(NulosTexto, {\\n        {\\\"cabal_recuperat\\\", LimpiarNumero},\\n        {\\\"ordre\\\", LimpiarNumero}\\n    }),\\n\\n    // 5. Reemplazo de nulos a -1 específico para sector_id\\n    SectorIdNulos = Table.ReplaceValue(BasuraNumericaCero, null, -1, Replacer.ReplaceValue, {\\\"sector_id\\\"}),\\n\\n    // 6. Cambiar el tipo de dato final de las columnas numéricas\\n    TiposCambiados = Table.TransformColumnTypes(SectorIdNulos, {\\n        {\\\"cabal_recuperat\\\", type number},\\n        {\\\"ordre\\\", Int64.Type},\\n        {\\\"sector_id\\\", Int64.Type},\\n        {\\\"km_inspeccionats_heli\\\", type number},\\n        {\\\"km_inspeccionats_acustic\\\", type number},\\n        {\\\"fuites_reparades_heli\\\", type number},\\n        {\\\"fuites_reparades_acustic\\\", type number},\\n        {\\\"fuites_reparades_altres\\\", type number},\\n        {\\\"maniobres_realitzades\\\", type number}\\n    }),\\n\\n    // 7. Un único paso masivo para reemplazar TODOS los nulos por 0 en las columnas numéricas\\n    NumerosNulosCero = Table.ReplaceValue(\\n        TiposCambiados, \\n        null, \\n        0, \\n        Replacer.ReplaceValue, \\n        {\\n            \\\"cabal_recuperat\\\", \\\"ordre\\\", \\\"km_inspeccionats_heli\\\", \\\"km_inspeccionats_acustic\\\",\\n            \\\"fuites_reparades_heli\\\", \\\"fuites_reparades_acustic\\\", \\\"fuites_reparades_altres\\\", \\\"maniobres_realitzades\\\"\\n        }\\n    ),\\n    #\\\"Valor reemplazado\\\" = Table.ReplaceValue(NumerosNulosCero,null,#date(2100, 1, 1),Replacer.ReplaceValue,{\\\"data_inici\\\"}),\\n    #\\\"Consultas combinadas\\\" = Table.NestedJoin(#\\\"Valor reemplazado\\\", {\\\"zona\\\"}, dim_gerencia, {\\\"gerencia\\\"}, \\\"dim_gerencia\\\", JoinKind.LeftOuter),\\n    #\\\"Se expandió dim_gerencia\\\" = Table.ExpandTableColumn(#\\\"Consultas combinadas\\\", \\\"dim_gerencia\\\", {\\\"gerencia_id\\\"}, {\\\"gerencia_id\\\"}),\\n    #\\\"Columnas quitadas\\\" = Table.RemoveColumns(#\\\"Se expandió dim_gerencia\\\",{\\\"zona\\\"})\\nin\\n    #\\\"Columnas quitadas\\\"\",\"ReferencedQueriesFormulaText\":{}}",
      "loadAsTableDisabled": false,
