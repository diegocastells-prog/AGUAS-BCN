      "lastLoadedAsTableFormulaText": "{\"IncludesReferencedQueries\":false,\"RootFormulaText\":\"let\\n    //==========================================================\\n    // Origen\\n    //==========================================================\\n    Origen =\\n        GoogleSheets.Contents(\\n            #\\\"Indicadors ANR 2026\\\"\\n        ),\\n\\n    Datos =\\n        Origen{[name=\\\"Inventari xarxa\\\", ItemKind=\\\"Table\\\"]}[Data],\\n\\n    Tabla =\\n        Table.SelectColumns(\\n            Table.FirstN(\\n                Table.Skip(\\n                    Table.RemoveColumns(Datos, {\\\"Column1\\\"}),\\n                    2\\n                ),\\n                182\\n            ),\\n            List.FirstN(\\n                Table.ColumnNames(\\n                    Table.FirstN(\\n                        Table.Skip(\\n                            Table.RemoveColumns(Datos, {\\\"Column1\\\"}),\\n                            2\\n                        ),\\n                        164\\n                    )\\n                ),\\n                19\\n            )\\n        ),\\n\\n    //==========================================================\\n    // Cabeceras\\n    //==========================================================\\n    Sectores =\\n        List.Transform(\\n            Record.ToList(Tabla{0}),\\n            each try Text.Trim(Text.From(_)) otherwise \\\"\\\"\\n        ),\\n\\n    Zonas =\\n        List.Transform(\\n            Record.ToList(Tabla{1}),\\n            each try Text.Trim(Text.From(_)) otherwise \\\"\\\"\\n        ),\\n\\n    SectoresRellenos =\\n        List.Accumulate(\\n            Sectores,\\n            {},\\n            (estado, actual) =>\\n                estado &\\n                {\\n                    if actual = \\\"\\\" then\\n                        if List.Count(estado) = 0 then \\\"\\\"\\n                        else List.Last(estado)\\n                    else\\n                        actual\\n                }\\n        ),\\n\\n    NuevosNombres =\\n        List.Transform(\\n            List.Positions(SectoresRellenos),\\n            (i) =>\\n                if i = 0 then\\n                    \\\"Mes\\\"\\n                else if Zonas{i} = \\\"\\\" then\\n                    SectoresRellenos{i}\\n                else\\n                    SectoresRellenos{i} & \\\" - \\\" & Zonas{i}\\n        ),\\n\\n    //==========================================================\\n    // Transformación\\n    //==========================================================\\n    Renombrada =\\n        Table.RenameColumns(\\n            Table.Skip(Tabla, 2),\\n            List.Zip({Table.ColumnNames(Tabla), NuevosNombres}),\\n            MissingField.Ignore\\n        ),\\n\\n    Despivotada =\\n        Table.UnpivotOtherColumns(\\n            Renombrada,\\n            {\\\"Mes\\\"},\\n            \\\"kpi\\\",\\n            \\\"valor\\\"\\n        ),\\n\\n    Split =\\n        Table.SplitColumn(\\n            Despivotada,\\n            \\\"kpi\\\",\\n            Splitter.SplitTextByDelimiter(\\\" - \\\", QuoteStyle.Csv),\\n            {\\\"kpi\\\", \\\"gerencia\\\"}\\n        ),\\n\\n    Resultado =\\n        Table.TransformColumns(\\n            Split,\\n            {\\n                {\\\"kpi\\\", Text.Trim, type text},\\n                {\\\"gerencia\\\", Text.Trim, type text}\\n            }\\n        ),\\n\\n    //==========================================================\\n    // Mapeo de KPIs\\n    //==========================================================\\n    MapaKPI =\\n        [\\n            #\\\"XARXA DISTRIBUCIÓ (DM Xarxes)\\\" = \\\"xarxa\\\",\\n            #\\\"SUBMINISTRAMENTS CONTROLATS (DM Xarxes)\\\" = \\\"subministraments\\\",\\n            #\\\"RAMALS CONTROLATS (DM Xarxes)\\\" = \\\"escomeses\\\"\\n        ],\\n\\n    KPIMapeado =\\n        Table.TransformColumns(\\n            Resultado,\\n            {\\n                {\\n                    \\\"kpi\\\",\\n                    each Record.FieldOrDefault(MapaKPI, _, _),\\n                    type text\\n                }\\n            }\\n        ),\\n\\n    //==========================================================\\n    // Limpieza\\n    //==========================================================\\n    ValorLimpio =\\n        Table.TransformColumns(\\n            KPIMapeado,\\n            {\\n                {\\n                    \\\"valor\\\",\\n                    each\\n                        if _ = null or _ = \\\"\\\" then\\n                            0\\n                        else\\n                            Number.From(_),\\n                    type number\\n                }\\n            }\\n        ),\\n\\n    Pivotado =\\n        Table.Pivot(\\n            ValorLimpio,\\n            List.Distinct(ValorLimpio[kpi]),\\n            \\\"kpi\\\",\\n            \\\"valor\\\",\\n            List.Sum\\n        ),\\n    #\\\"Valor reemplazado\\\" = Table.ReplaceValue(Pivotado,\\\"BCN Nord\\\",\\\"Barcelona Nord\\\",Replacer.ReplaceText,{\\\"gerencia\\\"}),\\n    #\\\"Valor reemplazado1\\\" = Table.ReplaceValue(#\\\"Valor reemplazado\\\",\\\"BCN Sud\\\",\\\"Barcelona Sud\\\",Replacer.ReplaceText,{\\\"gerencia\\\"}),\\n    #\\\"Mes convertido\\\" =\\n        Table.TransformColumns(\\n            #\\\"Valor reemplazado1\\\",\\n            {\\n                {\\n                    \\\"Mes\\\",\\n                    each \\n                        #date(\\n                            Number.FromText(Text.Start(Text.From(_),4)),\\n                            Number.FromText(Text.End(Text.From(_),2)),\\n                            1\\n                        ),\\n                    type date\\n                }\\n            }\\n        ),\\n    #\\\"Columnas con nombre cambiado\\\" = Table.RenameColumns(#\\\"Mes convertido\\\",{{\\\"Mes\\\", \\\"fecha\\\"}}),\\n    #\\\"Columna combinada insertada\\\" = Table.AddColumn(#\\\"Columnas con nombre cambiado\\\", \\\"gerencia_fecha\\\", each Text.Combine({[gerencia], \\\"-\\\", Text.From([fecha], \\\"es-ES\\\"), \\\" \\\"}), type text),\\n    #\\\"Filas filtradas\\\" = Table.SelectRows(#\\\"Columna combinada insertada\\\", each ([fecha] = #date(2025, 1, 1) or [fecha] = #date(2025, 2, 1) or [fecha] = #date(2025, 3, 1) or [fecha] = #date(2025, 4, 1) or [fecha] = #date(2025, 5, 1) or [fecha] = #date(2025, 6, 1) or [fecha] = #date(2025, 7, 1) or [fecha] = #date(2025, 8, 1) or [fecha] = #date(2025, 9, 1) or [fecha] = #date(2025, 10, 1) or [fecha] = #date(2025, 11, 1) or [fecha] = #date(2025, 12, 1) or [fecha] = #date(2026, 1, 1) or [fecha] = #date(2026, 2, 1) or [fecha] = #date(2026, 3, 1) or [fecha] = #date(2026, 4, 1) or [fecha] = #date(2026, 5, 1) or [fecha] = #date(2026, 6, 1) or [fecha] = #date(2026, 7, 1) or [fecha] = #date(2026, 8, 1) or [fecha] = #date(2026, 9, 1) or [fecha] = #date(2026, 10, 1) or [fecha] = #date(2026, 11, 1) or [fecha] = #date(2026, 12, 1))),\\n    #\\\"Consultas combinadas\\\" = Table.NestedJoin(#\\\"Filas filtradas\\\", {\\\"gerencia\\\"}, dim_gerencia, {\\\"gerencia\\\"}, \\\"dim_gerencia\\\", JoinKind.LeftOuter),\\n    #\\\"Se expandió dim_gerencia\\\" = Table.ExpandTableColumn(#\\\"Consultas combinadas\\\", \\\"dim_gerencia\\\", {\\\"gerencia_id\\\"}, {\\\"gerencia_id\\\"}),\\n    #\\\"Columnas quitadas\\\" = Table.RemoveColumns(#\\\"Se expandió dim_gerencia\\\",{\\\"gerencia\\\"}),\\n    #\\\"Columna dividida\\\" = Table.TransformColumns(#\\\"Columnas quitadas\\\", {{\\\"xarxa\\\", each _ / 1000, type number}})\\nin\\n    #\\\"Columna dividida\\\"\",\"ReferencedQueriesFormulaText\":{}}",
