    {
      "name": "BCN G Pressio",
      "lineageTag": "496dabf9-9532-4f5e-b419-1bbc4acb1896",
      "navigationStepName": "Navegación",
      "text": [
        "\"https://docs.google.com/spreadsheets/d/1NknnQkvQTlpWVaHLJML1QFtsnHEDRmkFK71aCEnrR5Q/edit?gid=1464564071#gid=1464564071\" meta [IsParameterQuery=true, Type=\"Any\", IsParameterQueryRequired=true]"
      ],
      "loadAsTableDisabled": true,
      "resultType": "Text",
      "isHidden": false
    },
    {
      "name": "fact_inventari_xarxa_distribucion",
      "lineageTag": "2b91454c-c160-4687-a602-165ee754b802",
      "queryGroupId": "25d3df3c-79ef-4ded-828c-d67fbd792c69",
      "navigationStepName": "Navegación",
      "text": [
        "let",
        "    //==========================================================",
        "    // Origen",
        "    //==========================================================",
        "    Origen =",
        "        GoogleSheets.Contents(",
        "            #\"Indicadors ANR 2026\"",
        "        ),",
        "",
        "    Datos =",
        "        Origen{[name=\"Inventari xarxa\", ItemKind=\"Table\"]}[Data],",
        "",
        "    Tabla =",
        "        Table.SelectColumns(",
        "            Table.FirstN(",
        "                Table.Skip(",
        "                    Table.RemoveColumns(Datos, {\"Column1\"}),",
        "                    2",
        "                ),",
        "                182",
        "            ),",
        "            List.FirstN(",
        "                Table.ColumnNames(",
        "                    Table.FirstN(",
        "                        Table.Skip(",
        "                            Table.RemoveColumns(Datos, {\"Column1\"}),",
        "                            2",
        "                        ),",
        "                        164",
        "                    )",
        "                ),",
        "                19",
        "            )",
        "        ),",
        "",
        "    //==========================================================",
        "    // Cabeceras",
        "    //==========================================================",
        "    Sectores =",
        "        List.Transform(",
        "            Record.ToList(Tabla{0}),",
        "            each try Text.Trim(Text.From(_)) otherwise \"\"",
        "        ),",
        "",
        "    Zonas =",
        "        List.Transform(",
        "            Record.ToList(Tabla{1}),",
        "            each try Text.Trim(Text.From(_)) otherwise \"\"",
        "        ),",
        "",
        "    SectoresRellenos =",
        "        List.Accumulate(",
        "            Sectores,",
        "            {},",
        "            (estado, actual) =>",
        "                estado &",
        "                {",
        "                    if actual = \"\" then",
        "                        if List.Count(estado) = 0 then \"\"",
        "                        else List.Last(estado)",
        "                    else",
        "                        actual",
        "                }",
        "        ),",
        "",
        "    NuevosNombres =",
        "        List.Transform(",
        "            List.Positions(SectoresRellenos),",
        "            (i) =>",
        "                if i = 0 then",
        "                    \"Mes\"",
        "                else if Zonas{i} = \"\" then",
        "                    SectoresRellenos{i}",
        "                else",
        "                    SectoresRellenos{i} & \" - \" & Zonas{i}",
        "        ),",
        "",
        "    //==========================================================",
        "    // Transformación",
        "    //==========================================================",
        "    Renombrada =",
        "        Table.RenameColumns(",
        "            Table.Skip(Tabla, 2),",
        "            List.Zip({Table.ColumnNames(Tabla), NuevosNombres}),",
        "            MissingField.Ignore",
        "        ),",
        "",
        "    Despivotada =",
        "        Table.UnpivotOtherColumns(",
        "            Renombrada,",
        "            {\"Mes\"},",
        "            \"kpi\",",
        "            \"valor\"",
        "        ),",
        "",
        "    Split =",
        "        Table.SplitColumn(",
        "            Despivotada,",
        "            \"kpi\",",
        "            Splitter.SplitTextByDelimiter(\" - \", QuoteStyle.Csv),",
        "            {\"kpi\", \"gerencia\"}",
        "        ),",
        "",
        "    Resultado =",
        "        Table.TransformColumns(",
        "            Split,",
        "            {",
        "                {\"kpi\", Text.Trim, type text},",
        "                {\"gerencia\", Text.Trim, type text}",
        "            }",
        "        ),",
        "",
        "    //==========================================================",
        "    // Mapeo de KPIs",
        "    //==========================================================",
        "    MapaKPI =",
        "        [",
        "            #\"XARXA DISTRIBUCIÓ (DM Xarxes)\" = \"xarxa\",",
        "            #\"SUBMINISTRAMENTS CONTROLATS (DM Xarxes)\" = \"subministraments\",",
        "            #\"RAMALS CONTROLATS (DM Xarxes)\" = \"escomeses\"",
        "        ],",
        "",
        "    KPIMapeado =",
        "        Table.TransformColumns(",
        "            Resultado,",
        "            {",
        "                {",
        "                    \"kpi\",",
        "                    each Record.FieldOrDefault(MapaKPI, _, _),",
        "                    type text",
        "                }",
        "            }",
        "        ),",
        "",
        "    //==========================================================",
        "    // Limpieza",
        "    //==========================================================",
        "    ValorLimpio =",
        "        Table.TransformColumns(",
        "            KPIMapeado,",
        "            {",
        "                {",
        "                    \"valor\",",
        "                    each",
        "                        if _ = null or _ = \"\" then",
        "                            0",
        "                        else",
        "                            Number.From(_),",
        "                    type number",
        "                }",
        "            }",
        "        ),",
        "",
        "    Pivotado =",
        "        Table.Pivot(",
        "            ValorLimpio,",
        "            List.Distinct(ValorLimpio[kpi]),",
        "            \"kpi\",",
        "            \"valor\",",
        "            List.Sum",
        "        ),",
        "    #\"Valor reemplazado\" = Table.ReplaceValue(Pivotado,\"BCN Nord\",\"Barcelona Nord\",Replacer.ReplaceText,{\"gerencia\"}),",
        "    #\"Valor reemplazado1\" = Table.ReplaceValue(#\"Valor reemplazado\",\"BCN Sud\",\"Barcelona Sud\",Replacer.ReplaceText,{\"gerencia\"}),",
        "    #\"Mes convertido\" =",
        "        Table.TransformColumns(",
        "            #\"Valor reemplazado1\",",
        "            {",
        "                {",
        "                    \"Mes\",",
        "                    each ",
        "                        #date(",
        "                            Number.FromText(Text.Start(Text.From(_),4)),",
        "                            Number.FromText(Text.End(Text.From(_),2)),",
        "                            1",
        "                        ),",
        "                    type date",
        "                }",
        "            }",
        "        ),",
        "    #\"Columnas con nombre cambiado\" = Table.RenameColumns(#\"Mes convertido\",{{\"Mes\", \"fecha\"}}),",
