mnTypes(#\\\"Columnas con nombre cambiado\\\",{{\\\"data_instal\\\", type date}, {\\\"gerencia\\\", type text}}),\\n    #\\\"Poner En Mayúsculas Cada Palabra2\\\" = Table.TransformColumns(#\\\"Tipo cambiado1\\\",{{\\\"gerencia\\\", Text.Proper, type text}}),\\n    #\\\"Filas ordenadas\\\" = Table.Sort(#\\\"Poner En Mayúsculas Cada Palabra2\\\",{{\\\"id\\\", Order.Ascending}}),\\n    #\\\"Filas filtradas\\\" = Table.SelectRows(#\\\"Filas ordenadas\\\", each true),\\n    #\\\"Columnas con nombre cambiado1\\\" = Table.RenameColumns(#\\\"Filas filtradas\\\",{{\\\"Núm. PC\\\", \\\"cod_gerenciapc\\\"}}),\\n    #\\\"Columnas reordenadas\\\" = Table.ReorderColumns(#\\\"Columnas con nombre cambiado1\\\",{\\\"cod_gerenciapc\\\", \\\"gerencia\\\", \\\"id\\\", \\\"data_instal\\\", \\\"tipus_regulac\\\"}),\\n    #\\\"Tipo cambiado2\\\" = Table.TransformColumnTypes(#\\\"Columnas reordenadas\\\",{{\\\"cod_gerenciapc\\\", type text}}),\\n    #\\\"Columnas quitadas\\\" = Table.RemoveColumns(#\\\"Tipo cambiado2\\\",{\\\"id\\\", \\\"gerencia\\\", \\\"data_instal\\\"}),\\n    #\\\"Filas ordenadas1\\\" = Table.Sort(#\\\"Columnas quitadas\\\",{{\\\"cod_gerenciapc\\\", Order.Ascending}})\\nin\\n    #\\\"Filas ordenadas1\\\"\",\"ReferencedQueriesFormulaText\":{}}",
