ado\\\" = Table.ReplaceValue(#\\\"Columnas con nombre cambiado\\\",\\\"\\\",\\\"No Disponible\\\",Replacer.ReplaceValue,{\\\"te_nit\\\", \\\"te_dia\\\"}),\\n    #\\\"Tipo cambiado1\\\" = Table.TransformColumnTypes(#\\\"Valor reemplazado\\\",{{\\\"pz_dia\\\", type number}, {\\\"preal_3\\\", type number}, {\\\"grup_pressio_5\\\", type number}}),\\n    #\\\"Columnas con nombre cambiado1\\\" = Table.RenameColumns(#\\\"Tipo cambiado1\\\",{{\\\"grup_pressio\\\", \\\"grup_pressio_nit\\\"}, {\\\"grup_pressio_5\\\", \\\"grup_pressio_dia\\\"}})\\nin\\n    #\\\"Columnas con nombre cambiado1\\\"\",\"ReferencedQueriesFormulaText\":{}}",
