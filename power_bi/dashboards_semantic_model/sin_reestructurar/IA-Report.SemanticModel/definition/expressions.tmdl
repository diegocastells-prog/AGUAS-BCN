		            [sector_id="3444", sector="Passeig De Sant Gervasi", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=2, latitud=null, longitud=null],
		            [sector_id="3308", sector="Plaça Barraquer", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=2, latitud=null, longitud=null],
		            [sector_id="3319", sector="Santa Rosa", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=3, latitud=null, longitud=null],
		            [sector_id="3354", sector="Santelvira", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=3, latitud=null, longitud=null],
		            [sector_id="3004", sector="Tibidabo Torreó", pressio=null, long_xarxa=null, ramals_controlats=null, subministraments_controlats=null, pressio_mitjana=null, lambert=null, afor_l_s=null, referencia=null, sector_activo=null, _1=null, _2=null, gerencia_id=2, latitud=null, longitud=null],
