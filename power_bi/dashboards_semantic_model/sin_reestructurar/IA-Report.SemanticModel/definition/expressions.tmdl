expression dim_sector_null =
		let
		    Origen =
		        #table(
		            type table [
		                sector_id = Int64.Type,
		                sector = text,
		                gerencia = text
		            ],
		            {
		                {-1, "No Disponible", "No Disponible"}
		            }
		        )
		in
		    Origen
