		    data = Origen{[name = "Sectores_sembrados_numero", ItemKind = "Table"]}[Data],
		    #"Otras columnas quitadas" = Table.SelectColumns(data, {"Column2", "Column6"}),
		    #"Filas filtradas" = Table.SelectRows(#"Otras columnas quitadas", each ([Column2] <> "")),
		    #"Encabezados promovidos" = Table.PromoteHeaders(#"Filas filtradas", [PromoteAllScalars = true]),
		    #"Columnas con nombre cambiado" = Table.RenameColumns(
		        #"Encabezados promovidos",
		        {{"SAP_ID_2", "sector_id"}, {"NUMPOINTS", "num_points"}}
		    ),
		    #"Duplicados eliminados" = Table.Distinct(
		        #"Columnas con nombre cambiado",
		        {"sector_id"}
		    ),
		    #"Tipo cambiado" = Table.TransformColumnTypes(
		        #"Duplicados eliminados",
		        {{"sector_id", Int64.Type}, {"num_points", Int64.Type}}
		    )
		in
		    #"Tipo cambiado"
