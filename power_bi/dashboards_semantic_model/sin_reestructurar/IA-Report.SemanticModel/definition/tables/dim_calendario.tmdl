	partition dim_calendario = calculated
		mode: import
		source = ```
				
				 
				ADDCOLUMNS(
				 
				    CALENDAR(
				        DATE(2020,1,1),
				        EOMONTH(TODAY(), -1)
				    ),
				 
				    "anio", YEAR([Date]),
				 
				    "mes_num", MONTH([Date]),
				 
				    "mes", SWITCH(MONTH([Date]), 1, "Gener", 2, "Febrer", 3, "Març", 4, "Abril", 5, "Maig", 6, "Juny", 7, "Juliol", 8, "Agost", 9, "Setembre", 10, "Octubre", 11, "Novembre", 12, "Desembre"),
				
				    "mes_corto", SWITCH(MONTH([Date]), 1, "Gen", 2, "Febr", 3, "Març", 4, "Abr", 5, "Maig", 6, "Juny", 7, "Jul", 8, "Ag", 9, "Set", 10, "Oct", 11, "Nov", 12, "Des"),
				    
				    "anio_mes_1", SWITCH(MONTH([Date]), 1, "Gen.", 2, "Febr.", 3, "Març.", 4, "Abr.", 5, "Maig.", 6, "Juny.", 7, "Jul.", 8, "Ag.", 9, "Set.", 10, "Oct.", 11, "Nov.", 12, "Des.") & " " & FORMAT([Date], "YYYY"),
				    
				    "anio_mes", SWITCH(MONTH([Date]), 1, "Gen", 2, "Febr", 3, "Març", 4, "Abr", 5, "Maig", 6, "Juny", 7, "Jul", 8, "Ag", 9, "Set", 10, "Oct", 11, "Nov", 12, "Des") & " " & FORMAT([Date], "YY"),
				 
				    "OrdenAnioMes", YEAR([Date]) * 100 + MONTH([Date]),
				    
				    "mmaa",
				        SWITCH(
				            MONTH([Date]),
				            1, "gen.",
				            2, "febr.",
				            3, "març",
				            4, "abr",
				            5, "maig",
				            6, "juny",
				            7, "jul",
				            8, "ag",
				            9, "set",
				            10, "oct",
				            11, "nov",
				            12, "des"
				        )
				& "." 
				& FORMAT(EDATE([Date], -12), "YYYY"),
				 
				    "ma",
				        SWITCH(
				            MONTH(EDATE([Date], -1)),
				            1, "gen.",
				            2, "febr.",
				            3, "març",
				            4, "abr",
				            5, "maig",
				            6, "juny",
				            7, "jul",
				            8, "ag",
				            9, "set",
				            10, "oct",
				            11, "nov",
				            12, "des"
				        )
				& "."
				& FORMAT(EDATE([Date], -1), "YYYY"),
				 
				 
				    "aniomes_corto", FORMAT([Date], "MM YY"),
				 
				    "aniomes_corto_con_guion", FORMAT([Date], "MM-YY"),
				 
				    "aniomes_num_corto", 
				        FORMAT([Date], "MM") & "/" & FORMAT([Date],"YY"),
				 
				    "anio2_mes", FORMAT([Date], "YY-MM"),
				 
				    "trimestre", "T" & FORMAT([Date], "Q"),
				 
				    "anio_trimestre", 
				        YEAR([Date]) & "-T" & FORMAT([Date], "Q"),
				 
				    "semana_anio", WEEKNUM([Date], 2),
				 
				    "dia", DAY([Date]),
				 
				    "dia_semana_num", WEEKDAY([Date], 2),
				 
				    "dia_semana", FORMAT([Date], "dddd"),
				 
				    "fin_de_semana", 
				        IF(
				            WEEKDAY([Date], 2) >= 6,
				            "si",
				            "no"
				        ),
				 
				    "status_date",
				        VAR FechaHoy = TODAY()
				        VAR MesActual = EOMONTH(FechaHoy, 0)
				        VAR MesCerradoReal = EOMONTH(FechaHoy, -3)
				        RETURN
				            SWITCH(
				                TRUE(),
				                [Date] <= MesCerradoReal, "REAL",
				                [Date] <= MesActual, "ESTIMADO",
				                "FUTURO"
				            ),
				 
				    "flag_anio",
				        SWITCH(
				            TRUE(),
				            YEAR([Date]) = YEAR(TODAY()), "ACTUAL",
				            YEAR([Date]) = YEAR(TODAY()) - 1, "ANTERIOR",
				            "OTRO"
				        )
				)
				```

	annotation PBI_Id = cd24ec39b23246859ff232dbebde1363

